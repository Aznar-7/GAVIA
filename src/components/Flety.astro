---
import Arrow from "./Arrow.astro";
// Flety: producto propio. A la derecha, un mapa real de la ruta Córdoba → puerto de
// San Lorenzo (RN9 / autopista) con la ida cargada y la vuelta que Flety llena, y un
// prototipo de la app del transportista. El mapa (MapLibre + OpenFreeMap) se carga solo
// cuando la sección se acerca; si falla, queda la carta dibujada como respaldo.
const cargas = [
  { que: "Fertilizante", t: "28 t", desde: "San Lorenzo", hasta: "Córdoba", match: "Toda tu vuelta" },
  { que: "Maquinaria agrícola", t: "12 t", desde: "Cañada de Gómez", hasta: "Villa María", match: "En tu camino" },
  { que: "Insumos para tambo", t: "8 t", desde: "Marcos Juárez", hasta: "Córdoba", match: "En tu camino" },
];
---

<section class="flety" id="flety" aria-labelledby="flety-title">
  <div class="wrap inner">
    <div class="copy">
      <h2 id="flety-title">Flety: que ningún camión vuelva vacío.</h2>
      <p class="lead">
        Todos los días, en toda la Argentina, hay camiones que llevan carga y vuelven vacíos. Esa vuelta se paga
        igual: combustible, peajes y horas de manejo. Flety conecta a ese transportista con alguien que necesita
        mandar algo en su camino. Es nuestro primer producto propio y está en desarrollo.
      </p>
      <ol class="how">
        <li><span><strong>El transportista</strong> publica su ruta y cuándo vuelve.</span></li>
        <li><span><strong>Flety</strong> le muestra las cargas que le quedan de paso.</span></li>
        <li><span><strong>El dador de carga</strong> reserva el viaje y sigue el envío.</span></li>
      </ol>

      <form class="wait" id="flety-form" novalidate>
        <fieldset>
          <legend>Anotate en la lista y probalo antes que nadie</legend>
          <div class="roles">
            <label><input type="radio" name="rol" value="Transportista" checked /> <span>Soy transportista</span></label>
            <label><input type="radio" name="rol" value="Dador de carga" /> <span>Necesito mandar carga</span></label>
          </div>
          <div class="row">
            <label for="flety-email" class="sr-only">Tu mail</label>
            <input id="flety-email" name="email" class="input" type="email" autocomplete="email" placeholder="tu@mail.com" aria-describedby="flety-msg" />
            <button class="btn" type="submit">Anotarme <Arrow /></button>
          </div>
          <div class="hp" aria-hidden="true">
            <label for="flety-gotcha">No completar</label>
            <input id="flety-gotcha" name="_gotcha" tabindex="-1" autocomplete="off" />
          </div>
          <p id="flety-msg" class="msg" aria-live="polite"></p>
        </fieldset>
      </form>
    </div>

    <div class="stage">
      <figure class="map-wrap" aria-label="Mapa de la Argentina con rutas de ejemplo: cada camión va cargado y vuelve con carga">
        <div class="map" data-flety-map></div>
        <svg class="fallback" viewBox="0 0 520 440" aria-hidden="true">
          <path d="M70 330 C 170 300, 300 170, 450 110" fill="none" stroke="var(--paper)" stroke-width="4"></path>
          <path d="M450 140 C 320 210, 200 330, 90 360" fill="none" stroke="var(--signal)" stroke-width="4" stroke-dasharray="12 9"></path>
          <rect x="58" y="318" width="24" height="24" fill="var(--signal)"></rect>
          <rect x="440" y="100" width="24" height="24" fill="var(--paper)"></rect>
        </svg>
        <figcaption class="legend">
          <span><i class="k ida"></i>Ida con carga</span>
          <span><i class="k vuelta"></i>Vuelta con carga</span>
        </figcaption>
      </figure>

      <div class="phone" role="figure" aria-label="Prototipo de la app de Flety para transportistas, con datos de ejemplo">
        <div class="screen">
          <div class="status"><span>9:41</span><span class="notch"></span><span>4G</span></div>
          <div class="app-head">
            <span class="app-logo">flety</span>
            <span class="pill">Prototipo</span>
          </div>
          <div class="trip">
            <span class="cap">Tu vuelta</span>
            <p class="route"><b>San Lorenzo</b><span class="dash"></span><b>Córdoba</b></p>
            <p class="when">Jueves · salís a las 14 h · 390 km</p>
          </div>
          <p class="cap list-cap">3 cargas en tu camino</p>
          <ul class="loads">
            {
              cargas.map((c, i) => (
                <li class={i === 0 ? "best" : ""}>
                  <div>
                    <b>{c.que}</b> <span class="t">{c.t}</span>
                    <p>{c.desde} → {c.hasta}</p>
                  </div>
                  <span class="tag">{c.match}</span>
                </li>
              ))
            }
          </ul>
          <span class="app-btn">Reservar carga</span>
          <p class="sample">Datos de ejemplo</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { sendForm, CONTACT_EMAIL } from "../config";

  // --- Lista de espera: se envía sin salir de la página.
  const form = document.getElementById("flety-form") as HTMLFormElement | null;
  const msg = document.getElementById("flety-msg");
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const email = form.elements.namedItem("email") as HTMLInputElement;
    const rol = (form.querySelector('input[name="rol"]:checked') as HTMLInputElement).value;
    const btn = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    if (!email.value.trim() || !email.checkValidity()) {
      email.setAttribute("aria-invalid", "true");
      if (msg) msg.textContent = "Revisá el mail: tiene que ser algo como nombre@dominio.com.";
      email.focus();
      return;
    }
    email.removeAttribute("aria-invalid");
    form.classList.add("is-sending");
    btn.disabled = true;
    if (msg) msg.textContent = "Anotándote…";
    try {
      const r = await sendForm(`Lista de espera Flety: ${rol}`, { rol, email: email.value, _gotcha: (form.elements.namedItem("_gotcha") as HTMLInputElement).value });
      if (r === "mailto") {
        if (msg) msg.textContent = `Te armamos el mail. Si no se abrió, escribinos a ${CONTACT_EMAIL}.`;
      } else {
        form.classList.add("is-done");
        if (msg) msg.textContent = r === "demo" ? "Modo prueba: así se ve cuando alguien se anota." : `Listo. Te avisamos a ${email.value} cuando Flety esté disponible.`;
      }
    } catch {
      if (msg) msg.textContent = `No pudimos anotarte. Probá de nuevo o escribinos a ${CONTACT_EMAIL}.`;
    } finally {
      form.classList.remove("is-sending");
      btn.disabled = false;
    }
  });

  // --- Mapa real, cargado bajo demanda
  // Rutas de ejemplo por todo el país: cada una es un camión que va cargado (A → B)
  // y que con Flety vuelve con carga (B → A). La primera, por RN9, lleva el camión animado.
  type LngLat = [number, number];
  const CBA: LngLat = [-64.1888, -31.4201];
  const ROUTES: { from: string; to: string; path: LngLat[] }[] = [
    {
      from: "Córdoba",
      to: "San Lorenzo",
      path: [CBA, [-63.6802, -31.9127], [-63.2405, -32.4075], [-62.689, -32.626], [-62.106, -32.697], [-61.395, -32.816], [-60.738, -32.75]],
    },
    { from: "Mendoza", to: "Buenos Aires", path: [[-68.8458, -32.8895], [-66.3356, -33.2950], [-64.3499, -33.1232], [-61.9625, -34.0731], [-58.3816, -34.6037]] },
    { from: "Tucumán", to: "Santa Fe", path: [[-65.2226, -26.8083], [-64.2615, -27.7951], [-62.8460, -29.9230], [-61.4867, -31.2526], [-60.7000, -31.6333]] },
    { from: "Neuquén", to: "Bahía Blanca", path: [[-68.0591, -38.9516], [-66.5562, -38.9730], [-64.3290, -38.9550], [-62.2663, -38.7183]] },
    { from: "Salta", to: "Córdoba", path: [[-65.4117, -24.7821], [-65.2226, -26.8083], [-64.8030, -28.4696], CBA] },
  ];
  const INK = "#12243a";
  const OWN_NAMES = ["Santa Fe", "Córdoba", "San Lorenzo", "Mendoza", "Buenos Aires", "Tucumán", "San Miguel de Tucumán", "Rosario", "Neuquén", "Bahía Blanca", "Salta", "Ciudad Autónoma de Buenos Aires"];

  const el = document.querySelector<HTMLElement>("[data-flety-map]");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  async function mountMap() {
    if (!el) return;
    try {
      const [{ default: maplibregl }] = await Promise.all([
        import("maplibre-gl"),
        import("maplibre-gl/dist/maplibre-gl.css"),
      ]);
      const map = new maplibregl.Map({
        container: el,
        style: "https://tiles.openfreemap.org/styles/positron",
        bounds: [
          [-69.5, -39.6],
          [-57.6, -24.2],
        ],
        fitBoundsOptions: { padding: { top: 70, bottom: 40, left: 30, right: 300 } },
        scrollZoom: false,
        dragRotate: false,
        pitchWithRotate: false,
        touchZoomRotate: false,
        attributionControl: false,
      });
      map.addControl(new maplibregl.AttributionControl({ compact: true }), "bottom-left");
      map.on("load", () => {
        // Recolorear la base a la paleta de la carta: tierra en tinta, agua más profunda.
        for (const layer of map.getStyle().layers ?? []) {
          const id = layer.id;
          if (layer.type === "background") map.setPaintProperty(id, "background-color", INK);
          else if (layer.type === "fill") {
            if (/water/.test(id)) map.setPaintProperty(id, "fill-color", "#0b1828");
            else map.setLayoutProperty(id, "visibility", "none");
          } else if (layer.type === "line") {
            if (/water|river|waterway/.test(id)) map.setPaintProperty(id, "line-color", "#1d3550");
            else if (/boundary|admin/.test(id)) map.setPaintProperty(id, "line-color", "rgba(241,244,247,0.25)");
            else map.setPaintProperty(id, "line-color", "rgba(241,244,247,0.10)");
          } else if (layer.type === "symbol") {
            if (/place|city|town/.test(id)) {
              map.setPaintProperty(id, "text-color", "#8fa3b8");
              map.setPaintProperty(id, "text-halo-color", INK);
              // Ocultar del mapa base las ciudades que ya marcamos nosotros.
              try {
                const base = map.getFilter(id);
                const hide = ["!", ["in", ["get", "name"], ["literal", OWN_NAMES]]];
                map.setFilter(id, (base ? ["all", base, hide] : hide) as any);
              } catch {}
            } else map.setLayoutProperty(id, "visibility", "none");
          }
        }

        const features = ROUTES.map((r, i) => ({
          type: "Feature",
          properties: { main: i === 0 },
          geometry: { type: "LineString", coordinates: r.path },
        }));
        map.addSource("rutas", { type: "geojson", data: { type: "FeatureCollection", features } as any });
        map.addLayer({
          id: "ida",
          type: "line",
          source: "rutas",
          layout: { "line-cap": "round", "line-join": "round" },
          paint: {
            "line-color": "#f1f4f7",
            "line-width": ["case", ["get", "main"], 3, 2],
            "line-opacity": ["case", ["get", "main"], 1, 0.55],
            "line-offset": -3,
          },
        });
        map.addLayer({
          id: "vuelta",
          type: "line",
          source: "rutas",
          layout: { "line-join": "round" },
          paint: {
            "line-color": "#f06a2a",
            "line-width": ["case", ["get", "main"], 3.5, 2.5],
            "line-opacity": ["case", ["get", "main"], 1, 0.7],
            "line-offset": 3,
            "line-dasharray": [2, 1.5],
          },
        });

        // Extremos de cada ruta, sin repetir ciudades.
        const ends = new Map<string, LngLat>();
        for (const r of ROUTES) {
          ends.set(r.from, r.path[0]);
          ends.set(r.to, r.path[r.path.length - 1]);
        }
        for (const [name, at] of ends) {
          const m = document.createElement("div");
          m.className = "pin";
          m.innerHTML = `<i></i><span>${name}</span>`;
          new maplibregl.Marker({ element: m, anchor: "left", offset: [-6, 0] }).setLngLat(at).addTo(map);
        }

        // Un camión recorre la vuelta de la ruta principal en loop.
        const truck = document.createElement("div");
        truck.className = "truck";
        const main = ROUTES[0].path;
        const marker = new maplibregl.Marker({ element: truck }).setLngLat(main[main.length - 1]).addTo(map);
        if (!reduce) {
          const back = [...main].reverse();
          const seg = back.slice(1).map((p, i) => Math.hypot(p[0] - back[i][0], p[1] - back[i][1]));
          const total = seg.reduce((x, y) => x + y, 0);
          const DURATION = 9000;
          let start = 0;
          let raf = 0;
          const tick = (t: number) => {
            if (!start) start = t;
            let d = (((t - start) % DURATION) / DURATION) * total;
            let i = 0;
            while (i < seg.length - 1 && d > seg[i]) d -= seg[i++];
            const k = Math.min(1, d / seg[i]);
            const p0 = back[i];
            const p1 = back[i + 1];
            marker.setLngLat([p0[0] + (p1[0] - p0[0]) * k, p0[1] + (p1[1] - p0[1]) * k]);
            raf = requestAnimationFrame(tick);
          };
          // El camión solo anda mientras el mapa está en pantalla: fuera de vista no gasta batería.
          new IntersectionObserver(([entry]) => {
            cancelAnimationFrame(raf);
            if (entry.isIntersecting) raf = requestAnimationFrame(tick);
          }).observe(el);
        }
        el.closest(".map-wrap")?.classList.add("ready");
      });
    } catch {
      // Sin WebGL o sin red: queda la carta dibujada.
    }
  }

  // Con "ahorro de datos" o conexión lenta no se baja el mapa (unos 800 KB): queda la carta dibujada.
  const conn = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
  const lowData = !!conn && (conn.saveData === true || /(^|-)2g$/.test(conn.effectiveType ?? ""));

  // Si el mapa no se muestra (celular), no se carga.
  const shown = !!el && getComputedStyle(el.closest(".map-wrap") ?? el).display !== "none";

  if (el && shown && !lowData) {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          mountMap();
        }
      },
      { rootMargin: "600px 0px" },
    );
    io.observe(el);
  }
</script>

<style>
  /* Campo trampa para bots: fuera de la pantalla, no se ve ni se enfoca. */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .flety {
    margin-top: var(--space-section);
    padding-block: clamp(72px, 10vw, 140px);
    background: var(--ink);
    color: var(--paper);
    overflow: hidden;
  }
  .flety ::selection {
    background: var(--signal);
    color: var(--ink);
  }
  .inner {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 88px);
    align-items: center;
  }
  .copy {
    display: grid;
    gap: 24px;
    min-width: 0;
  }
  h2 {
    font-size: var(--fs-3xl);
  }
  .lead {
    max-width: 52ch;
    font-size: var(--fs-lg);
    color: var(--paper-soft);
  }
  .how {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: how;
    display: grid;
    gap: 12px;
    color: var(--paper-soft);
  }
  .how li {
    counter-increment: how;
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    gap: 10px;
  }
  .how li::before {
    content: counter(how);
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border: 1.5px solid rgb(241 244 247 / 0.6);
    color: var(--paper);
    font: 600 0.75rem var(--mono);
  }
  .how strong {
    color: var(--paper);
  }
  fieldset {
    margin: 0;
    padding: 24px 0 0;
    border: 0;
    border-top: 1px solid rgb(241 244 247 / 0.25);
    display: grid;
    gap: 16px;
  }
  legend {
    float: left;
    width: 100%;
    font-weight: 700;
    font-size: var(--fs-md);
  }
  .roles {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .roles label {
    cursor: pointer;
  }
  .roles input {
    position: absolute;
    opacity: 0;
  }
  .roles span {
    display: inline-block;
    padding: 10px 16px;
    border: 1.5px solid rgb(241 244 247 / 0.5);
    font-weight: 600;
    transition: background-color 200ms var(--ease-out), border-color 200ms var(--ease-out), color 200ms;
  }
  .roles label:hover span {
    border-color: var(--paper);
    background: rgb(241 244 247 / 0.12);
  }
  .roles label:active span {
    transform: translateY(1px);
  }
  .roles input:checked + span {
    background: var(--paper);
    color: var(--ink);
    border-color: var(--paper);
  }
  .roles input:focus-visible + span {
    outline: 2px solid var(--signal);
    outline-offset: 3px;
  }
  .row {
    display: flex;
    max-width: 520px;
  }
  .row .input {
    flex: 1;
    min-width: 0;
    border-color: var(--paper);
    border-right: 0;
  }
  .row .btn {
    border-color: var(--paper);
    background: transparent;
    color: var(--paper);
  }
  .row .btn::before {
    background: var(--paper);
  }
  .row .btn:hover {
    color: var(--ink);
  }
  .wait.is-sending .row {
    opacity: 0.6;
  }
  .wait.is-done .row,
  .wait.is-done .roles {
    display: none;
  }
  .wait.is-done .msg {
    padding: 14px 16px;
    border: 1.5px solid var(--paper);
    color: var(--paper);
    font-weight: 600;
    animation: fade-in 500ms var(--ease-out);
  }
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  .msg {
    min-height: 1.5em;
    font-size: var(--fs-sm);
    color: var(--paper-soft);
  }

  /* Escenario: mapa real + teléfono */
  .stage {
    position: relative;
    min-width: 0;
    padding-bottom: clamp(150px, 18vw, 280px);
  }
  .map-wrap {
    position: relative;
    margin: 0;
    aspect-ratio: 5 / 4;
    border: 1.5px solid rgb(241 244 247 / 0.5);
    outline: 1px solid rgb(241 244 247 / 0.25);
    outline-offset: -8px;
    background: #0f1f33;
    overflow: hidden;
  }
  .map {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 700ms var(--ease-out);
  }
  .ready .map {
    opacity: 1;
  }
  .fallback {
    position: absolute;
    inset: 10%;
    width: 80%;
    height: 80%;
    transition: opacity 400ms;
  }
  .ready .fallback {
    opacity: 0;
  }
  .legend {
    position: absolute;
    top: 18px;
    right: 18px;
    z-index: 2;
    display: grid;
    gap: 6px;
    padding: 10px 14px;
    background: var(--ink);
    border: 1px solid rgb(241 244 247 / 0.35);
    font-size: var(--fs-sm);
    color: var(--paper-soft);
  }
  .legend span {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .k {
    width: 26px;
    border-top: 3px solid var(--paper);
  }
  .k.vuelta {
    border-top: 3px dashed var(--signal);
  }
  .map-wrap :global(.pin) {
    display: flex;
    align-items: center;
    gap: 8px;
    pointer-events: none;
  }
  .map-wrap :global(.pin i) {
    width: 10px;
    height: 10px;
    background: var(--ink);
    border: 2px solid var(--paper);
  }
  .map-wrap :global(.pin.main i) {
    width: 14px;
    height: 14px;
    background: var(--paper);
  }
  .map-wrap :global(.pin span) {
    font: 500 11px var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--paper);
    text-shadow: 0 0 6px var(--ink), 0 0 2px var(--ink);
  }
  .map-wrap :global(.truck) {
    width: 18px;
    height: 12px;
    background: var(--signal);
    border: 2px solid var(--paper);
  }
  .map-wrap :global(.maplibregl-ctrl-attrib) {
    background: rgb(18 36 58 / 0.85);
    color: var(--paper-soft);
    font-size: 11px;
  }
  .map-wrap :global(.maplibregl-ctrl-attrib a) {
    color: var(--paper-soft);
  }

  /* Teléfono: marco dibujado en CSS, pantalla con la app. */
  .phone {
    position: absolute;
    z-index: 3;
    right: clamp(-24px, -1vw, 0px);
    bottom: 0;
    width: clamp(230px, 19vw, 272px);
    padding: 10px;
    background: #0a1522;
    border: 1.5px solid rgb(241 244 247 / 0.4);
    border-radius: 34px;
    transition: transform 500ms var(--ease-out);
  }
  .phone:hover {
    transform: translateY(-6px);
  }
  .screen {
    display: grid;
    gap: 10px;
    padding: 12px 12px 14px;
    background: var(--paper);
    color: var(--ink);
    border-radius: 25px;
    font-size: 12px;
    line-height: 1.35;
  }
  .status {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font: 600 10px var(--body);
  }
  .notch {
    width: 64px;
    height: 16px;
    background: #0a1522;
    border-radius: 10px;
  }
  .app-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .app-logo {
    font: 800 18px/1 var(--display);
    letter-spacing: -0.04em;
  }
  .pill {
    padding: 2px 8px;
    border: 1px solid var(--ink);
    font: 600 9px var(--body);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .trip {
    display: grid;
    gap: 4px;
    padding: 10px;
    background: var(--ink);
    color: var(--paper);
  }
  .cap {
    font: 600 9px var(--body);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .trip .cap {
    color: var(--paper-soft);
