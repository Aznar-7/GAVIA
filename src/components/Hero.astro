---
// Primera pantalla, en el azul de la marca. A la izquierda, qué somos y qué hacemos en una frase.
// A la derecha, lo que nos diferencia hecho objeto: la propuesta escrita que te llevás antes de
// que construyamos nada. Se firma sola al cargar. Es un ejemplo y dice que lo es.
import { TEAM, whatsappUrl } from "../config";
const wa = whatsappUrl();
const nombres = `${TEAM.slice(0, -1).map((m) => m.nombre.split(" ")[0]).join(", ")} o ${TEAM.at(-1)!.nombre.split(" ")[0]}`;
const etapas = [
  ["Pedidos y clientes", "3 semanas"],
  ["Stock y alertas", "3 semanas"],
  ["Reportes", "2 semanas"],
];
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="wrap inner">
    <div class="copy">
      <h1 id="hero-title">
        <span class="l" style="--i:0"><span>Si tiene solución,</span></span>
        <span class="l" style="--i:1"><span>la construimos.</span></span>
        <span class="tone rise" style="--i:2">Software y tecnología a medida para lo que hoy traba tu empresa.</span>
      </h1>
      <p class="lead rise" style="--i:3">
        Desde reemplazar un Excel hasta automatizar un proceso o conectar tus máquinas. Antes de construir, te damos por
        escrito qué vas a recibir y cuánto cuesta.
      </p>
      <div class="actions rise" style="--i:4">
        <a class="btn" href="#contacto">Contanos tu proyecto</a>
        <a class="btn ghost" href="#servicios">Ver qué hacemos</a>
      </div>
      <p class="note rise" style="--i:5">
        La primera charla es gratis. Te responde {nombres} en menos de un día hábil.
        {wa && <a href={wa} target="_blank" rel="noopener">Escribinos por WhatsApp</a>}
      </p>
    </div>

    <figure class="sheet" aria-label="Ejemplo de la propuesta que te damos por escrito antes de empezar">
      <div class="head">
        <p class="title">Propuesta</p>
        <span class="tag">Ejemplo</span>
      </div>
      <table>
        <thead>
          <tr><th>Etapa</th><th>Plazo</th><th>Precio</th></tr>
        </thead>
        <tbody>
          {etapas.map(([e, p]) => <tr><td>{e}</td><td>{p}</td><td>Cerrado</td></tr>)}
        </tbody>
      </table>
      <ul>
        <li>Pagás etapa por etapa y podés frenar cuando quieras.</li>
        <li>Con cada etapa pagada, el código es tuyo.</li>
      </ul>
      <div class="sign">
        <div>
          <svg viewBox="0 0 120 44" aria-hidden="true"><path pathLength="1" d="M4 32C14 14 22 6 26 8c5 3-8 26-4 27 5 1 12-18 17-17 4 1-3 14 1 15 5 1 9-9 14-8 5 1 3 7 8 6 9-1 26-8 50-12" /></svg>
          <p>Gavia</p>
        </div>
        <div><p>Vos</p></div>
      </div>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 1;
    background: var(--navy);
    color: var(--on-navy);
    padding-block: clamp(40px, 6vw, 88px) clamp(48px, 6vw, 80px);
  }
  .inner {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 40px clamp(40px, 6vw, 104px);
    align-items: center;
  }
  .copy {
    display: grid;
    gap: 22px;
    justify-items: start;
  }
  h1 {
    font-size: clamp(2.75rem, 6.2vw, 5.75rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.035em;
  }
  h1 .l {
    display: block;
    overflow: hidden;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }
  h1 .l > span {
    display: block;
  }
  .tone {
    display: block;
    max-width: 19em;
    margin-top: 0.42em;
    font-size: 0.56em;
    font-weight: 500;
    line-height: 1.16;
    letter-spacing: -0.025em;
    color: var(--paper-soft);
  }
  .lead {
    max-width: 54ch;
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--paper-soft);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }
  .ghost {
    background: transparent;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.4);
    color: var(--on-navy);
  }
  @media (hover: hover) {
    .ghost:hover {
      background: rgb(255 255 255 / 0.1);
    }
  }
  .note {
    font-size: var(--fs-sm);
    color: var(--paper-soft);
  }
  .note a {
    display: inline-block;
    margin-block: -12px;
    margin-left: 4px;
    padding-block: 12px;
    font-weight: 700;
    color: var(--on-navy);
  }

  /* La hoja: papel en los dos temas. Baja sobre la sección siguiente, como un documento apoyado. */
  .sheet {
    --tinta: var(--navy);
    --raya: rgb(18 36 58 / 0.14);
    position: relative;
    align-self: end;
    margin: 0 0 calc(clamp(48px, 6vw, 80px) * -1 - 64px);
    padding: clamp(24px, 2.6vw, 36px);
    border-radius: var(--radius-sm);
    background: var(--on-navy);
    color: var(--tinta);
    font-size: var(--fs-sm);
    box-shadow: 0 2px 4px rgb(8 18 30 / 0.2), 0 32px 64px rgb(8 18 30 / 0.34);
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-bottom: 14px;
    border-bottom: 2px solid var(--tinta);
  }
  .title {
    font: 600 var(--fs-xl) / 1.1 var(--display);
    letter-spacing: -0.02em;
  }
  .tag {
    padding: 2px 10px;
    border-radius: 999px;
    background: rgb(18 36 58 / 0.08);
    font-size: var(--fs-xs);
    font-weight: 600;
  }
  table {
    width: 100%;
    border-collapse: collapse;
  }
  th {
    padding: 12px 8px 8px 0;
    border-bottom: 1px solid var(--raya);
    color: rgb(18 36 58 / 0.68);
    font-weight: 600;
    text-align: left;
  }
  td {
    padding: 11px 8px 11px 0;
    border-bottom: 1px solid var(--raya);
    font-variant-numeric: tabular-nums;
  }
  td:not(:first-child) {
    white-space: nowrap;
  }
  td:first-child {
    font-weight: 600;
  }
  ul {
    display: grid;
    gap: 4px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }
  .sign {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    align-items: end;
    margin-top: 20px;
  }
  .sign svg {
    display: block;
    width: 112px;
    height: 42px;
    margin-bottom: -6px;
    overflow: visible;
  }
  .sign path {
    fill: none;
    stroke: var(--signal);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
  }
  .sign p {
    padding-top: 8px;
    border-top: 1px solid var(--tinta);
    font-weight: 600;
  }

  /* Entrada: el título sube línea por línea, la hoja se apoya y al final se firma. */
  :global(html.js:not(.reduce)) h1 .l > span {
    animation: line-up 1000ms var(--ease-out) both;
    animation-delay: calc(120ms + var(--i) * 110ms);
  }
  :global(html.js:not(.reduce)) .rise {
    animation: rise 900ms var(--ease-out) both;
    animation-delay: calc(120ms + var(--i) * 110ms);
  }
  :global(html.js:not(.reduce)) .sheet {
    animation: lay 1100ms var(--ease-out) 240ms both;
  }
  :global(html.js:not(.reduce)) .sign path {
    animation: sign 1100ms cubic-bezier(0.65, 0, 0.35, 1) 1100ms both;
  }
  @keyframes line-up {
    from {
      transform: translateY(105%);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  @keyframes lay {
    from {
      opacity: 0;
      transform: translateY(32px) rotate(1deg);
    }
  }
  @keyframes sign {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Laptops bajas: los botones tienen que quedar en la primera pantalla. */
  @media (min-width: 1001px) and (max-height: 760px) {
    .hero {
      padding-top: 32px;
    }
    h1 {
      font-size: clamp(2.75rem, 5vw, 4.5rem);
    }
    .copy {
      gap: 16px;
    }
  }
  @media (max-width: 1000px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
    }
    h1 {
      font-size: clamp(2.75rem, 8.6vw, 5rem);
    }
    .sheet {
      max-width: 560px;
      margin-bottom: 0;
    }
  }
  @media (max-width: 640px) {
    .actions {
      display: grid;
      width: 100%;
    }
  }
</style>
