---
// Primera pantalla: qué hacemos, para quién y cómo se arranca. A la derecha, software nuestro
// funcionando: el registro real de InscriBot, legible, sobre una captura de UTN Hub. Las capas
// se separan apenas con el scroll. Sin ilustraciones.
import { Image } from "astro:assets";
import { TEAM, whatsappUrl } from "../config";
import capManager from "../assets/utnhub/utn-manager.png";
import capLog from "../assets/utnhub/inscribot-log.png";
const wa = whatsappUrl();
const nombres = `${TEAM.slice(0, -1).map((m) => m.nombre.split(" ")[0]).join(", ")} o ${TEAM.at(-1)!.nombre.split(" ")[0]}`;
const facts = ["Primera charla gratis", "Precio cerrado por etapa", "El código es tuyo"];
const lineas = ["Si tiene solución,", "la construimos."];
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="wrap inner">
    <div class="copy">
      <h1 id="hero-title">
        {lineas.map((l, i) => <span class="l" style={`--i:${i}`}><span>{l}</span></span>)}
      </h1>
      <p class="lead rise" style="--i:2">
        Software y tecnología a medida para lo que hoy traba tu empresa: desde reemplazar un Excel hasta automatizar un
        proceso o conectar tus máquinas. Antes de construir, te damos por escrito qué vas a recibir y cuánto cuesta cada
        etapa.
      </p>
      <div class="actions rise" style="--i:3">
        <a class="btn" href="#contacto">Contanos tu proyecto</a>
        <a class="btn secondary" href="#como-trabajamos">Ver cómo trabajamos</a>
      </div>
      <ul class="facts rise" style="--i:4" aria-label="Condiciones">
        {
          facts.map((f) => (
            <li>
              <svg viewBox="0 0 16 14" width="16" height="14" aria-hidden="true"><path d="M2 7l4 4 8-9" /></svg>
              {f}
            </li>
          ))
        }
      </ul>
      <p class="note rise" style="--i:5">
        Somos un estudio de Córdoba. Te responde {nombres} en menos de un día hábil.
        {wa && <a href={wa} target="_blank" rel="noopener">Escribinos por WhatsApp</a>}
      </p>
    </div>

    <figure class="stage" data-stage>
      <div class="layer main" style="--z:0.6">
        <Image src={capManager} alt="" widths={[600, 900, 1300]} sizes="(max-width: 960px) 96vw, 50vw" loading="eager" />
      </div>
      <div class="layer front" style="--z:1.6">
        <Image
          src={capLog}
          alt="Registro de InscriBot: detecta un cupo libre y confirma la inscripción sin que nadie toque nada."
          widths={[500, 825]}
          sizes="(max-width: 960px) 92vw, 44vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <figcaption>Un robot nuestro haciendo un trámite solo, dentro de UTN Hub. <a href="#proyectos">Ver el caso</a></figcaption>
    </figure>
  </div>
</section>

<script>
  // Profundidad: al bajar, cada capa se corre según su --z.
  const stage = document.querySelector<HTMLElement>("[data-stage]");
  if (stage && !document.documentElement.classList.contains("reduce")) {
    let raf = 0;
    const apply = () => {
      raf = 0;
      stage.style.setProperty("--sy", scrollY.toFixed(1));
    };
    addEventListener(
      "scroll",
      () => {
        if (scrollY <= innerHeight * 1.2) raf ||= requestAnimationFrame(apply);
      },
      { passive: true },
    );
  }
</script>

<style>
  .hero {
    overflow: hidden;
    background: var(--paper);
    padding-block: clamp(48px, 7vw, 96px) clamp(64px, 9vw, 120px);
  }
  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }
  .copy {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  h1 {
    font-size: var(--fs-hero);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  h1 .l {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  h1 .l > span {
    display: block;
  }
  .lead {
    max-width: 44ch;
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--ink-soft);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-weight: 600;
    font-size: var(--fs-sm);
  }
  .facts li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .facts svg {
    fill: none;
    stroke: var(--success);
    stroke-width: 2.4;
  }
  .note {
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .note a {
    display: inline-block;
    margin-left: 4px;
    padding-block: 12px;
    font-weight: 700;
    color: var(--ink);
  }

  /* Entrada: el título sube línea por línea y el resto aparece escalonado. */
  :global(html.js:not(.reduce)) h1 .l > span {
    animation: line-up 1000ms var(--ease-out) both;
    animation-delay: calc(var(--intro, 120ms) + var(--i) * 110ms);
  }
  :global(html.js:not(.reduce)) .rise {
    animation: rise 900ms var(--ease-out) both;
    animation-delay: calc(var(--intro, 120ms) + var(--i) * 110ms);
  }
  :global(html.js:not(.reduce)) .stage {
    animation: stage-in 1400ms var(--ease-out) both;
    animation-delay: calc(var(--intro, 120ms) + 200ms);
  }
  @keyframes line-up {
    from {
      transform: translateY(105%);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  @keyframes stage-in {
    from {
      opacity: 0;
      transform: translateX(60px);
    }
  }

  /* Escenario: dos capturas en capas. La de atrás se sale del contenedor por la derecha. */
  .stage {
    --sy: 0;
    position: relative;
    margin: 0 calc(var(--gutter) * -1 - max(0px, (100vw - var(--max)) / 2)) 0 0;
    aspect-ratio: 16 / 10;
    min-width: 0;
  }
  .layer {
    position: absolute;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow);
    transform: translate3d(0, calc(var(--sy) * var(--z) * -0.08px), 0);
    transition: transform 500ms var(--ease-out);
    will-change: transform;
  }
  .layer :global(img) {
    width: 100%;
    height: auto;
  }
  .main {
    top: 0;
    left: 12%;
    width: 100%;
    z-index: 1;
  }
  .front {
    bottom: 4%;
    left: 0;
    width: 84%;
    z-index: 2;
    border-color: var(--ink);
    box-shadow: 0 2px 4px rgb(18 36 58 / 0.1), 0 24px 48px rgb(18 36 58 / 0.22);
  }
  figcaption {
    position: absolute;
    left: 0;
    bottom: -32px;
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  figcaption a {
    display: inline-block;
    margin-block: -12px;
    padding-block: 12px;
    font-weight: 600;
    color: var(--ink);
  }

  @media (max-width: 960px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
    }
    .stage {
      margin: 8px calc(var(--gutter) * -1) 40px 0;
    }
  }
  @media (max-width: 640px) {
    .copy {
      gap: 20px;
    }
    .actions {
      display: grid;
      width: 100%;
    }
    .facts {
      flex-direction: column;
    }
    .stage {
      aspect-ratio: 16 / 12;
    }
    .front {
      width: 94%;
    }
    figcaption {
      bottom: -40px;
      right: var(--gutter);
    }
  }
</style>
