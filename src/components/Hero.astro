---
// Primera pantalla: qué hacemos, para quién y cómo se arranca, con una captura real de un
// sistema nuestro en uso al lado. Sin ilustraciones: lo que se ve es software de verdad.
import { Image } from "astro:assets";
import { TEAM, whatsappUrl } from "../config";
import captura from "../assets/utnhub/utn-manager.png";
const wa = whatsappUrl();
const nombres = `${TEAM.slice(0, -1).map((m) => m.nombre.split(" ")[0]).join(", ")} o ${TEAM.at(-1)!.nombre.split(" ")[0]}`;
const facts = ["Primera charla gratis", "Precio cerrado por etapa", "El código es tuyo"];
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="wrap inner">
    <div class="copy">
      <h1 id="hero-title">Software a medida para tu empresa.</h1>
      <p class="lead">
        Pasamos tu negocio de Excel y WhatsApp a un sistema propio. Antes de empezar te damos por escrito qué vas a
        recibir y cuánto cuesta cada etapa. Somos un estudio de software de Córdoba.
      </p>
      <div class="actions">
        <a class="btn" href="#contacto">Contanos tu proyecto</a>
        <a class="btn secondary" href="#como-trabajamos">Ver cómo trabajamos</a>
      </div>
      <ul class="facts" aria-label="Condiciones">
        {
          facts.map((f) => (
            <li>
              <svg viewBox="0 0 16 14" width="16" height="14" aria-hidden="true"><path d="M2 7l4 4 8-9" /></svg>
              {f}
            </li>
          ))
        }
      </ul>
      <p class="note">
        Te responde {nombres} en menos de un día hábil.
        {wa && <a href={wa} target="_blank" rel="noopener">Escribinos por WhatsApp</a>}
      </p>
    </div>

    <figure class="shot">
      <div class="frame">
        <Image
          src={captura}
          alt="UTN Manager, parte de UTN Hub: próximas entregas y novedades traídas del aula virtual, con botón para agendarlas."
          widths={[600, 900, 1300]}
          sizes="(max-width: 960px) 92vw, 640px"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <figcaption>UTN Hub, un sistema hecho por nosotros que hoy está en uso. <a href="#proyectos">Ver el caso</a></figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    background: var(--paper);
    padding-block: clamp(48px, 7vw, 96px) clamp(56px, 8vw, 112px);
  }
  .inner {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .copy {
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  h1 {
    font-size: var(--fs-hero);
    line-height: 1.05;
    letter-spacing: -0.025em;
    max-width: 14ch;
  }
  .lead {
    max-width: 44ch;
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--ink-soft);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-weight: 600;
    font-size: var(--fs-sm);
  }
  .facts li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .facts svg {
    fill: none;
    stroke: var(--success);
    stroke-width: 2.4;
  }
  .note {
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .note a {
    display: inline-block;
    margin-left: 4px;
    padding-block: 12px;
    font-weight: 700;
    color: var(--ink);
  }

  /* Captura real en un marco simple. */
  .shot {
    margin: 0;
    display: grid;
    gap: 12px;
    min-width: 0;
  }
  .frame {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow);
  }
  .frame img {
    width: 100%;
    height: auto;
  }
  figcaption {
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  figcaption a {
    font-weight: 600;
    color: var(--ink);
  }

  @media (max-width: 960px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
    }
    h1 {
      max-width: 16ch;
    }
  }
  @media (max-width: 640px) {
    .copy {
      gap: 20px;
    }
    .actions {
      display: grid;
      width: 100%;
    }
    .facts {
      flex-direction: column;
    }
  }
</style>
