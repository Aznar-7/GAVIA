---
// Cómo trabajamos: el momento pico de la página, en azul marino de borde a borde.
// En pantallas grandes la sección queda fija mientras bajás: la línea de rumbo naranja
// avanza etapa por etapa y a la derecha cambia el documento que te llevás.
// En el celular, con "reducir movimiento" o sin JS, las etapas se apilan y cada una
// trae su documento en un desplegable.
import ProcesoDoc from "./ProcesoDoc.astro";
const etapas = [
  {
    nombre: "Relevamiento",
    hacemos: "Nos sentamos con vos y con quienes van a usar el sistema para entender cómo trabajan hoy.",
    recibis: "Un documento de requerimientos para leer y aprobar.",
    tuParte: "Una o dos charlas.",
  },
  {
    nombre: "Propuesta",
    hacemos: "Con los requerimientos aprobados, definimos alcance, plazos y precio, dividido en etapas.",
    recibis: "Una propuesta con precio cerrado por etapa.",
    tuParte: "Elegir con qué etapa arrancamos.",
  },
  {
    nombre: "Desarrollo",
    hacemos: "Construimos en ciclos cortos y te mostramos avances que podés usar, no capturas.",
    recibis: "Una versión para probar cada dos semanas.",
    tuParte: "Probar y contarnos qué ajustar.",
  },
  {
    nombre: "Puesta en marcha",
    hacemos: "Instalamos, pasamos tus datos y capacitamos a tu equipo hasta que lo usen solos.",
    recibis: "El sistema funcionando y un manual de uso.",
    tuParte: "Sumar a tu equipo a la capacitación.",
  },
  {
    nombre: "Mantenimiento",
    hacemos: "Soporte, mejoras y copias de seguridad con un abono mensual. Es opcional.",
    recibis: "Un reporte mensual de lo que se hizo.",
    tuParte: "Nada, salvo pedir lo que necesites.",
  },
];
---

<section class="process" id="como-trabajamos" aria-labelledby="proceso-title" data-process style={`--n:${etapas.length}`}>
  <div class="track">
    <div class="sticky wrap">
      <div class="left">
        <div class="head">
          <h2 id="proceso-title" data-reveal>Cómo trabajamos.</h2>
          <p data-reveal style="--d:1">
            Cada paso termina en algo que podés leer, probar o firmar. La construcción se divide en etapas: pagás una
            por una y podés frenar después de cualquiera.
          </p>
        </div>

        <div class="stages-wrap">
        <span class="rail" aria-hidden="true"><span class="fill"></span></span>
        <ol class="stages">
          {
            etapas.map((e, i) => (
              <li class="stage" id={`etapa-${i + 1}`} data-stage={i}>
                <h3>
                  <button type="button" class="stage-head tap" data-go={i} disabled>
                    <span class="num" aria-hidden="true">{i + 1}</span>
                    <span>{e.nombre}</span>
                  </button>
                </h3>
                <div class="body">
                  <div class="body-in">
                  <p class="does">{e.hacemos}</p>
                  <dl>
                    <div>
                      <dt>Te llevás</dt>
                      <dd>{e.recibis}</dd>
                    </div>
                    <div>
                      <dt>Tu parte</dt>
                      <dd>{e.tuParte}</dd>
                    </div>
                  </dl>
                  <details class="mdoc">
                    <summary class="tap">Ver el documento de ejemplo</summary>
                    <ProcesoDoc i={i} />
                  </details>
                  </div>
                </div>
              </li>
            ))
          }
        </ol>
        </div>
      </div>

      <div class="docs" aria-hidden="true">
        <p class="count" data-count>Paso 1 de {etapas.length}</p>
        {
          etapas.map((_, i) => (
            <div class="doc-slot" data-doc={i}>
              <ProcesoDoc i={i} />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-process]");
  const reduce = document.documentElement.classList.contains("reduce");
  const wide = matchMedia("(min-width: 1000px) and (min-height: 640px)");
  if (root && !reduce) {
    const track = root.querySelector<HTMLElement>(".track")!;
    const wrap = root.querySelector<HTMLElement>(".stages-wrap")!;
    const stages = [...root.querySelectorAll<HTMLElement>("[data-stage]")];
    const heads = [...root.querySelectorAll<HTMLButtonElement>("[data-go]")];
    const docs = [...root.querySelectorAll<HTMLElement>("[data-doc]")];
    const count = root.querySelector<HTMLElement>("[data-count]")!;
    const n = stages.length;
    let raf = 0;
    let lastP = -1;
    let lastStage = -1;

    const update = () => {
      raf = 0;
      const pinned = root.classList.contains("pinned");
      const r = (pinned ? track : wrap).getBoundingClientRect();
      // Fija: avanza con el recorrido de la sección. Apilada: la línea llega hasta donde estás leyendo.
      const raw = pinned ? -r.top / (r.height - innerHeight) : (innerHeight * 0.6 - r.top) / r.height;
      const p = Math.min(1, Math.max(0, raw));
      if (p === lastP) return; // fuera de la sección no se toca nada
      lastP = p;
      root.style.setProperty("--p", p.toFixed(4));
      const current = Math.min(n - 1, Math.floor(p * n));
      if (current === lastStage) return;
      lastStage = current;
      stages.forEach((s, i) => {
        s.classList.toggle("current", i === current);
        s.classList.toggle("done", i < current);
      });
      heads.forEach((b, i) => b.toggleAttribute("aria-current", i === current));
      // Los documentos de las etapas hechas quedan apilados detrás del actual.
      docs.forEach((d, i) => {
        d.classList.toggle("current", i === current);
        d.classList.toggle("before", i < current);
        d.style.setProperty("--k", String(Math.min(3, current - i)));
      });
      count.textContent = `Paso ${current + 1} de ${n}`;
    };
    const queue = () => (raf ||= requestAnimationFrame(update));

    const mode = () => {
      root.classList.add("live");
      root.classList.toggle("pinned", wide.matches);
      // Fija, el encabezado de cada etapa es un botón que lleva a esa etapa.
      heads.forEach((b) => (b.disabled = !wide.matches));
      lastP = lastStage = -1;
      queue();
    };
    wide.addEventListener("change", mode);
    addEventListener("scroll", queue, { passive: true });
    addEventListener("resize", queue);
    mode();

    root.addEventListener("click", (e) => {
      const b = (e.target as Element).closest<HTMLElement>("[data-go]");
      if (!b || !root.classList.contains("pinned")) return;
      const i = Number(b.dataset.go);
      const span = track.offsetHeight - innerHeight;
      scrollTo({ top: track.getBoundingClientRect().top + scrollY + ((i + 0.5) / n) * span, behavior: "smooth" });
    });
  }
</script>

<style>
  .process {
    --p: 0;
    background: var(--ink);
    color: var(--white);
  }
  .process ::selection {
    background: var(--signal);
    color: var(--ink);
  }
  .sticky {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(32px, 6vw, 96px);
    padding-block: var(--space-section);
  }
  .head {
    display: grid;
    gap: 16px;
    max-width: 640px;
    margin-bottom: clamp(32px, 4vw, 48px);
  }
  .head p {
    color: var(--paper-soft);
    font-size: var(--fs-lg);
  }

  /* Etapas con la línea de rumbo a la izquierda. */
  .stages-wrap {
    position: relative;
  }
  .stages {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rail {
    position: absolute;
    top: 22px;
    bottom: 22px;
    left: 21px;
    width: 3px;
    background: rgb(255 255 255 / 0.14);
  }
  .fill {
    position: absolute;
    inset: 0;
    background: var(--signal);
    transform-origin: top;
  }
  .stage-head {
    display: flex;
    align-items: center;
    gap: 18px;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-align: left;
    cursor: default;
  }
  .num {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 3px solid var(--signal);
    background: var(--ink);
    font-weight: 700;
    transition: background-color 300ms var(--ease-out), color 300ms var(--ease-out), transform 300ms var(--ease-out);
  }
  h3 {
    font-size: var(--fs-xl);
    transition: color 300ms var(--ease-out);
  }
  .body {
    display: grid;
    padding: 8px 0 20px 62px;
  }
  .body-in {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
    min-height: 0;
  }
  .does {
    max-width: 52ch;
    color: var(--paper-soft);
  }
  dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    max-width: 560px;
  }
  dt {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--paper-soft);
  }
  dd {
    margin: 2px 0 0;
    font-weight: 600;
  }
  .mdoc summary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid rgb(255 255 255 / 0.3);
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: var(--fs-sm);
    cursor: pointer;
    list-style: none;
  }
  .mdoc summary::-webkit-details-marker {
    display: none;
  }
  .mdoc[open] summary {
    margin-bottom: 14px;
  }
  .docs {
    display: none;
  }

  /* ---------- Modo fijo (pantallas grandes, con JS y movimiento) ---------- */
  .pinned .track {
    height: calc(var(--n) * 55vh + 100vh);
  }
  .pinned .sticky {
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    position: sticky;
    top: 0;
    height: 100vh;
    align-items: center;
    padding-block: 72px 32px;
  }
  .live .fill {
    transform: scaleY(var(--p));
  }
  .pinned .stage-head {
    cursor: pointer;
  }
  .pinned .stage h3 {
    color: rgb(255 255 255 / 0.55);
  }
  .pinned .stage h3:hover {
    color: var(--white);
  }
  .pinned .stage.done h3 {
    color: rgb(255 255 255 / 0.75);
  }
  .live .stage.done .num,
  .live .stage.current .num {
    background: var(--signal);
    color: var(--ink);
  }
  .live .stage.current .num {
    transform: scale(1.12);
  }
  .pinned .stage.current h3 {
    color: var(--white);
  }
  /* Solo la etapa actual muestra su detalle; el resto queda en una línea. */
  .pinned .body {
    display: grid;
    grid-template-rows: 0fr;
    padding-block: 0;
    overflow: hidden;
    opacity: 0;
    transition: grid-template-rows 500ms var(--ease-out), opacity 400ms var(--ease-out), padding 500ms var(--ease-out);
  }
  .pinned .body-in {
    overflow: hidden;
  }
  .pinned .stage.current .body {
    grid-template-rows: 1fr;
    padding-block: 8px 12px;
    opacity: 1;
  }
  .pinned .mdoc {
    display: none;
  }
  .pinned .docs {
    position: relative;
    display: block;
    align-self: center;
    height: min(520px, 66vh);
  }
  .count {
    font-weight: 700;
    color: var(--signal);
    font-variant-numeric: tabular-nums;
  }
  /* Pila de entregables: el actual adelante, los de etapas hechas corridos atrás,
     los que faltan esperan abajo, invisibles. */
  .doc-slot {
    position: absolute;
    inset: 96px 0 auto 48px;
    opacity: 0;
    transform: translateY(80px) rotate(2deg);
    transition: opacity 500ms var(--ease-out), transform 800ms var(--ease-out), filter 500ms var(--ease-out);
    pointer-events: none;
  }
  .doc-slot.before {
    --k: 1;
    z-index: calc(10 - var(--k));
    opacity: 1;
    filter: brightness(calc(1 - var(--k) * 0.14));
    transform: translate(calc(var(--k) * -16px), calc(var(--k) * -22px)) scale(calc(1 - var(--k) * 0.05));
  }
  .doc-slot.current {
    z-index: 20;
    opacity: 1;
    transform: none;
  }

  /* Laptops bajas: todo tiene que entrar en la pantalla fija. */
  @media (max-height: 720px) {
    .pinned .sticky {
      padding-block: 72px 12px;
    }
    .pinned .head {
      gap: 8px;
      margin-bottom: 16px;
    }
    .pinned .head p {
      font-size: var(--fs-md);
    }
  }

  @media (max-width: 640px) {
    .stages {
      gap: 20px;
    }
    /* El documento usa todo el ancho, por encima de la línea de rumbo. */
    .mdoc > :global(.doc) {
      position: relative;
      width: calc(100% + 62px);
      margin-left: -62px;
    }
    dl {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
    }
  }
</style>
