---
// Cómo trabajamos: cinco etapas en una fila unida por la línea de rumbo naranja, el único
// gesto de marca del sitio. Debajo de cada etapa, qué hacemos, qué te llevás y qué te toca.
// Al final, dos entregables de ejemplo (marcados como tales) para que se vea que son reales.
const etapas = [
  {
    nombre: "Relevamiento",
    hacemos: "Nos sentamos con vos y con quienes van a usar el sistema para entender cómo trabajan hoy.",
    recibis: "Un documento de requerimientos para leer y aprobar.",
    tuParte: "Una o dos charlas.",
  },
  {
    nombre: "Propuesta",
    hacemos: "Con los requerimientos aprobados, definimos alcance, plazos y precio, dividido en etapas.",
    recibis: "Una propuesta con precio cerrado por etapa.",
    tuParte: "Elegir con qué etapa arrancamos.",
  },
  {
    nombre: "Desarrollo",
    hacemos: "Construimos en ciclos cortos y te mostramos avances que podés usar, no capturas.",
    recibis: "Una versión para probar cada dos semanas.",
    tuParte: "Probar y contarnos qué ajustar.",
  },
  {
    nombre: "Puesta en marcha",
    hacemos: "Instalamos, pasamos tus datos y capacitamos a tu equipo hasta que lo usen solos.",
    recibis: "El sistema funcionando y un manual de uso.",
    tuParte: "Sumar a tu equipo a la capacitación.",
  },
  {
    nombre: "Mantenimiento",
    hacemos: "Soporte, mejoras y monitoreo con un abono mensual. Es opcional.",
    recibis: "Un reporte mensual de lo que se hizo.",
    tuParte: "Nada, salvo pedir lo que necesites.",
  },
];
const check = "M2 7l4 4 8-9";
---

<section class="section" id="como-trabajamos" aria-labelledby="proceso-title">
  <div class="wrap">
    <div class="sec-head">
      <h2 id="proceso-title">Cómo trabajamos.</h2>
      <p>
        Cada etapa termina en algo que podés leer, probar o firmar. Pagás etapa por etapa y podés frenar después de
        cualquiera.
      </p>
    </div>

    <ol class="steps" data-steps>
      {
        etapas.map((e, i) => (
          <li class="step" id={`etapa-${i + 1}`}>
            <span class="num" aria-hidden="true">{i + 1}</span>
            <h3>{e.nombre}</h3>
            <p class="does">{e.hacemos}</p>
            <dl>
              <div>
                <dt>Te llevás</dt>
                <dd>{e.recibis}</dd>
              </div>
              <div>
                <dt>Tu parte</dt>
                <dd>{e.tuParte}</dd>
              </div>
            </dl>
          </li>
        ))
      }
    </ol>

    <details class="samples" open data-samples>
      <summary class="samples-title">Así se ven dos de los documentos que te entregamos.</summary>
      <div class="sample-grid">
        <figure class="sheet" aria-label="Ejemplo de documento de requerimientos">
          <span class="pill">Ejemplo</span>
          <p class="doc-title">Requerimientos <span>versión 1.0</span></p>
          <ul class="reqs">
            <li><b>Hace</b> Cargar pedidos de clientes desde el celular</li>
            <li><b>Hace</b> Mostrar en qué estado está cada pedido</li>
            <li><b>Hace</b> Avisar cuando falta stock de un producto</li>
            <li><b>Tiene que</b> Funcionar con mala señal</li>
          </ul>
          <p class="approved">
            <svg viewBox="0 0 16 14" width="16" height="14" aria-hidden="true"><path d={check} /></svg>
            Aprobado por el cliente
          </p>
        </figure>
        <figure class="sheet" aria-label="Ejemplo de propuesta con precio por etapa">
          <span class="pill">Ejemplo</span>
          <p class="doc-title">Propuesta</p>
          <table class="plan">
            <thead>
              <tr><th>Etapa</th><th>Incluye</th><th>Plazo</th><th>Precio</th></tr>
            </thead>
            <tbody>
              <tr><td class="coord">1</td><td>Pedidos y clientes</td><td class="coord">3 semanas</td><td>Cerrado</td></tr>
              <tr><td class="coord">2</td><td>Stock y alertas</td><td class="coord">2 semanas</td><td>Cerrado</td></tr>
              <tr><td class="coord">3</td><td>Reportes</td><td class="coord">2 semanas</td><td>Cerrado</td></tr>
            </tbody>
          </table>
          <p class="approved">Pagás etapa por etapa y podés frenar después de cualquiera.</p>
        </figure>
      </div>
    </details>
  </div>
</section>

<script>
  // La línea de rumbo se traza una vez cuando la fila entra en pantalla. Sin JS o con
  // movimiento reducido, se ve completa desde el principio.
  // En celular los documentos de ejemplo van plegados; en pantallas grandes, abiertos.
  const samples = document.querySelector<HTMLDetailsElement>("[data-samples]");
  const narrow = matchMedia("(max-width: 760px)");
  const fold = () => samples && (samples.open = !narrow.matches);
  narrow.addEventListener("change", fold);
  fold();

  const steps = document.querySelector<HTMLElement>("[data-steps]");
  if (steps && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    steps.classList.add("will-draw");
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        steps.classList.add("drawn");
        io.disconnect();
      },
      { threshold: 0.4 },
    );
    io.observe(steps);
  }
</script>

<style>
  /* Fila de etapas: la línea de rumbo pasa por los números. */
  .steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .steps::before {
    content: "";
    position: absolute;
    top: 19px;
    left: 20px;
    /* Termina en el centro del último número. */
    right: calc((100% - 4 * 28px) / 5 - 20px);
    border-top: 3px solid var(--signal);
    transform-origin: left;
  }
  .will-draw::before {
    transform: scaleX(0);
    transition: transform 1400ms var(--ease-out);
  }
  .will-draw.drawn::before {
    transform: scaleX(1);
  }
  /* Las cinco columnas comparten filas: los "Te llevás" quedan alineados. */
  .steps {
    grid-template-rows: repeat(4, auto);
    row-gap: 10px;
  }
  .step {
    position: relative;
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    align-content: start;
    scroll-margin-top: 100px;
  }
  .num {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-bottom: 8px;
    border-radius: 50%;
    border: 3px solid var(--signal);
    background: var(--white);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    transition: background-color 220ms var(--ease-out), transform 220ms var(--ease-out);
  }
  /* La etapa que mirás se marca en el rumbo. */
  .step:hover .num {
    background: var(--signal);
    transform: scale(1.08);
  }
  h3 {
    font-size: var(--fs-lg);
  }
  .does {
    color: var(--ink-soft);
    font-size: var(--fs-sm);
  }
  dl {
    display: grid;
    gap: 10px;
    margin: 6px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }
  dt {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--muted);
  }
  dd {
    margin: 2px 0 0;
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  /* Entregables de ejemplo: hojas blancas con borde suave. */
  .samples {
    margin-top: clamp(48px, 6vw, 72px);
  }
  .samples-title {
    font-weight: 700;
    font-size: var(--fs-lg);
    list-style: none;
    pointer-events: none;
  }
  .samples-title::-webkit-details-marker {
    display: none;
  }
  .samples[open] .sample-grid {
    margin-top: 20px;
  }
  .sample-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  .sheet {
    position: relative;
    margin: 0;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow);
  }
  .sheet .pill {
    position: absolute;
    top: 20px;
    right: 20px;
  }
  .doc-title {
    display: flex;
    gap: 12px;
    align-items: baseline;
    padding-bottom: 12px;
    margin-bottom: 4px;
    border-bottom: 1px solid var(--line);
    font-weight: 700;
    font-size: var(--fs-lg);
  }
  .doc-title span {
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--muted);
  }
  .reqs {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .reqs li {
    display: grid;
    grid-template-columns: 6.5em minmax(0, 1fr);
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-sm);
    color: var(--ink-soft);
  }
  .reqs b {
    color: var(--ink);
  }
  .approved {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    font-weight: 600;
    font-size: var(--fs-sm);
  }
  .approved svg path {
    fill: none;
    stroke: var(--success);
    stroke-width: 2.4;
  }
  .plan {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
  }
  .plan th {
    text-align: left;
    font-weight: 600;
    color: var(--muted);
    padding: 8px 12px 8px 0;
    border-bottom: 1px solid var(--line);
  }
  .plan td {
    padding: 10px 12px 10px 0;
    border-bottom: 1px solid var(--line);
  }
  .plan td.coord {
    white-space: nowrap;
  }

  @media (max-width: 1000px) {
    .sample-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  /* Tablet y celular: las etapas se apilan y la línea de rumbo baja por la izquierda. */
  @media (max-width: 900px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      gap: 28px;
      padding-left: 60px;
    }
    .step {
      grid-row: auto;
      grid-template-rows: none;
      gap: 10px;
    }
    .steps::before {
      top: 20px;
      bottom: 20px;
      left: 19px;
      right: auto;
      border-top: 0;
      border-left: 3px solid var(--signal);
      transform-origin: top;
    }
    .will-draw::before {
      transform: scaleY(0);
    }
    .will-draw.drawn::before {
      transform: scaleY(1);
    }
    .num {
      position: absolute;
      left: -60px;
      top: -6px;
    }
    dl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
  }
  /* Celular: el título de los ejemplos pasa a ser un botón para abrirlos. */
  @media (max-width: 760px) {
    .samples-title {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      min-height: 48px;
      padding: 12px 16px;
      border: 1px solid var(--line-strong);
      border-radius: var(--radius-sm);
      font-size: var(--fs-md);
      pointer-events: auto;
      cursor: pointer;
    }
    .samples-title::after {
      content: "+";
      font-size: var(--fs-xl);
      line-height: 1;
    }
    .samples[open] .samples-title::after {
      content: "−";
    }
  }
  @media (max-width: 560px) {
    .sheet {
      padding: 22px 18px;
    }
    .sheet .pill {
      position: static;
      margin-bottom: 10px;
    }
    .reqs li {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }
    dl {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
    }
  }
</style>
