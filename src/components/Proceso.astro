---
// Cómo trabajamos: el momento pico de la página, en azul marino de borde a borde.
// En pantallas grandes la sección queda fija mientras bajás: la línea de rumbo naranja
// avanza etapa por etapa y a la derecha cambia el documento que te llevás.
// En el celular, con "reducir movimiento" o sin JS, las etapas se apilan y cada una
// trae su documento en un desplegable.
import ProcesoDoc from "./ProcesoDoc.astro";
const etapas = [
  {
    nombre: "Relevamiento",
    hacemos: "Nos sentamos con vos y con quienes van a usar el sistema para entender cómo trabajan hoy.",
    recibis: "Un documento de requerimientos para leer y aprobar.",
    tuParte: "Una o dos charlas.",
  },
  {
    nombre: "Propuesta",
    hacemos: "Con los requerimientos aprobados, definimos alcance, plazos y precio, dividido en etapas.",
    recibis: "Una propuesta con precio cerrado por etapa.",
    tuParte: "Elegir con qué etapa arrancamos.",
  },
  {
    nombre: "Desarrollo",
    hacemos: "Construimos en ciclos cortos y te mostramos avances que podés usar, no capturas.",
    recibis: "Una versión para probar cada dos semanas.",
    tuParte: "Probar y contarnos qué ajustar.",
  },
  {
    nombre: "Puesta en marcha",
    hacemos: "Instalamos, pasamos tus datos y capacitamos a tu equipo hasta que lo usen solos.",
    recibis: "El sistema funcionando y un manual de uso.",
    tuParte: "Sumar a tu equipo a la capacitación.",
  },
  {
    nombre: "Mantenimiento",
    hacemos: "Soporte, mejoras y monitoreo con un abono mensual. Es opcional.",
    recibis: "Un reporte mensual de lo que se hizo.",
    tuParte: "Nada, salvo pedir lo que necesites.",
  },
];
---

<section class="process" id="como-trabajamos" aria-labelledby="proceso-title" data-process data-tone="dark" style={`--n:${etapas.length}`}>
  <div class="track">
    <div class="sticky wrap">
      <div class="left">
        <div class="head">
          <p class="kicker" data-reveal>Proceso</p>
          <h2 id="proceso-title" data-reveal>Cómo <span class="em">trabajamos</span>.</h2>
          <p data-reveal style="--d:1">
            Cada etapa termina en algo que podés leer, probar o firmar. Pagás etapa por etapa y podés frenar después de
            cualquiera.
          </p>
        </div>

        <div class="stages-wrap">
        <span class="rail" aria-hidden="true"><span class="fill"></span></span>
        <ol class="stages">
          {
            etapas.map((e, i) => (
              <li class="stage" id={`etapa-${i + 1}`} data-stage={i}>
                <button type="button" class="stage-head tap" data-go={i} tabindex="-1">
                  <span class="num" aria-hidden="true">{i + 1}</span>
                  <h3>{e.nombre}</h3>
                </button>
                <div class="body">
                  <div class="body-in">
                  <p class="does">{e.hacemos}</p>
                  <dl>
                    <div>
                      <dt>Te llevás</dt>
                      <dd>{e.recibis}</dd>
                    </div>
                    <div>
                      <dt>Tu parte</dt>
                      <dd>{e.tuParte}</dd>
                    </div>
                  </dl>
                  <details class="mdoc">
                    <summary class="tap">Ver el documento de ejemplo</summary>
                    <ProcesoDoc i={i} />
                  </details>
                  </div>
                </div>
              </li>
            ))
          }
        </ol>
        </div>
      </div>

      <div class="docs" aria-hidden="true">
        <p class="count" data-count>Etapa 1 de {etapas.length}</p>
        {
          etapas.map((_, i) => (
            <div class="doc-slot" data-doc={i}>
              <ProcesoDoc i={i} />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-process]");
  const reduce = document.documentElement.classList.contains("reduce");
  const wide = matchMedia("(min-width: 1000px) and (min-height: 640px)");
  if (root && !reduce) {
    const track = root.querySelector<HTMLElement>(".track")!;
    const stages = [...root.querySelectorAll<HTMLElement>("[data-stage]")];
    const docs = [...root.querySelectorAll<HTMLElement>("[data-doc]")];
    const count = root.querySelector<HTMLElement>("[data-count]")!;
    const n = stages.length;
    let raf = 0;

    const update = () => {
      raf = 0;
      if (!root.classList.contains("pinned")) return;
      const r = track.getBoundingClientRect();
      const span = r.height - innerHeight;
      const p = Math.min(1, Math.max(0, -r.top / span));
      const current = Math.min(n - 1, Math.floor(p * n));
      root.style.setProperty("--p", p.toFixed(4));
      stages.forEach((s, i) => {
        s.classList.toggle("current", i === current);
        s.classList.toggle("done", i < current);
      });
      // Los documentos de las etapas hechas quedan apilados detrás del actual.
      docs.forEach((d, i) => {
        d.classList.toggle("current", i === current);
        d.classList.toggle("before", i < current);
        d.style.setProperty("--k", String(Math.min(3, current - i)));
      });
      count.textContent = `Etapa ${current + 1} de ${n}`;
    };
    const queue = () => (raf ||= requestAnimationFrame(update));

    const mode = () => {
      root.classList.toggle("pinned", wide.matches);
      // Fija, el encabezado de cada etapa es un botón que lleva a esa etapa.
      root.querySelectorAll<HTMLButtonElement>("[data-go]").forEach((b) => (b.tabIndex = wide.matches ? 0 : -1));
      queue();
    };
    wide.addEventListener("change", mode);
    addEventListener("scroll", queue, { passive: true });
    addEventListener("resize", queue);
    mode();

    root.addEventListener("click", (e) => {
      const b = (e.target as Element).closest<HTMLElement>("[data-go]");
      if (!b || !root.classList.contains("pinned")) return;
      const i = Number(b.dataset.go);
      const span = track.offsetHeight - innerHeight;
      scrollTo({ top: track.getBoundingClientRect().top + scrollY + ((i + 0.5) / n) * span, behavior: "smooth" });
    });
  }
</script>

<style>
  .process {
    --p: 0;
    position: relative;
    isolation: isolate;
    background:
      radial-gradient(50% 60% at 85% 50%, rgb(240 106 42 / 0.1), transparent 70%),
      radial-gradient(40% 50% at 0% 0%, rgb(56 104 168 / 0.22), transparent 70%),
      var(--night);
    color: var(--white);
  }
  .process .kicker {
    color: var(--paper-soft);
  }
  .head h2 :global(.em) {
    color: #ffd9c4;
  }
  .process ::selection {
    background: var(--signal);
    color: var(--ink);
  }
  .sticky {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(32px, 6vw, 96px);
    padding-block: var(--space-section);
  }
  .head {
    display: grid;
    gap: 20px;
    justify-items: start;
    max-width: 640px;
    margin-bottom: clamp(32px, 4vw, 48px);
  }
  .head p:not(.kicker) {
    max-width: 46ch;
    color: var(--paper-soft);
    font-size: var(--fs-lg);
  }

  /* Etapas con la línea de rumbo a la izquierda. */
  .stages-wrap {
    position: relative;
  }
  .stages {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rail {
    position: absolute;
    top: 22px;
    bottom: 22px;
    left: 21px;
    width: 3px;
    background: rgb(255 255 255 / 0.1);
    border-radius: 3px;
  }
  .fill {
    position: absolute;
    inset: 0;
    background: var(--signal);
    border-radius: inherit;
    transform-origin: top;
  }
  .stage-head {
    display: flex;
    align-items: center;
    gap: 18px;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    text-align: left;
    cursor: default;
  }
  .num {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    border: 1.5px solid rgb(240 106 42 / 0.7);
    background: var(--night);
    font-weight: 600;
    font-size: var(--fs-sm);
    font-variant-numeric: tabular-nums;
    transition: background-color 300ms var(--ease-out), color 300ms var(--ease-out), transform 300ms var(--ease-out);
  }
  h3 {
    font-size: var(--fs-xl);
    font-weight: 500;
    letter-spacing: -0.025em;
    transition: color 300ms var(--ease-out);
  }
  .body {
    display: grid;
    padding: 8px 0 20px 62px;
  }
  .body-in {
    display: grid;
    gap: 12px;
    min-height: 0;
  }
  .does {
    max-width: 52ch;
    color: var(--paper-soft);
  }
  dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    max-width: 560px;
  }
  dt {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--paper-soft);
  }
  dd {
    margin: 4px 0 0;
    font-weight: 500;
  }
  .mdoc summary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: var(--radius-sm);
    font-weight: 500;
    font-size: var(--fs-sm);
    cursor: pointer;
    list-style: none;
  }
  .mdoc summary::-webkit-details-marker {
    display: none;
  }
  .mdoc[open] summary {
    margin-bottom: 14px;
  }
  .docs {
    display: none;
  }

  /* ---------- Modo fijo (pantallas grandes, con JS y movimiento) ---------- */
  .pinned .track {
    height: calc(var(--n) * 70vh + 100vh);
  }
  .pinned .sticky {
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    position: sticky;
    top: 0;
    height: 100vh;
    align-items: center;
    padding-block: 72px 32px;
  }
  .pinned .fill {
    transform: scaleY(var(--p));
  }
  .pinned .stage-head {
    cursor: pointer;
  }
  .pinned .stage-head:hover h3 {
    color: var(--white);
  }
  .pinned .stage h3 {
    color: rgb(255 255 255 / 0.45);
  }
  .pinned .stage.done h3 {
    color: rgb(255 255 255 / 0.75);
  }
  .pinned .stage.done .num,
  .pinned .stage.current .num {
    border-color: var(--signal);
    background: var(--signal);
    color: var(--ink);
  }
  .pinned .stage.current .num {
    box-shadow: 0 0 0 6px rgb(240 106 42 / 0.15), 0 0 24px rgb(240 106 42 / 0.45);
  }
  .pinned .stage.current .num {
    transform: scale(1.12);
  }
  .pinned .stage.current h3 {
    color: var(--white);
  }
  /* Solo la etapa actual muestra su detalle; el resto queda en una línea. */
  .pinned .body {
    display: grid;
    grid-template-rows: 0fr;
    padding-block: 0;
    overflow: hidden;
    opacity: 0;
    transition: grid-template-rows 500ms var(--ease-out), opacity 400ms var(--ease-out), padding 500ms var(--ease-out);
  }
  .pinned .body-in {
    overflow: hidden;
  }
  .pinned .stage.current .body {
    grid-template-rows: 1fr;
    padding-block: 8px 12px;
    opacity: 1;
  }
  .pinned .mdoc {
    display: none;
  }
  .pinned .docs {
    position: relative;
    display: block;
    align-self: center;
    height: min(520px, 66vh);
  }
  .count {
    font-weight: 500;
    color: var(--signal);
    font-variant-numeric: tabular-nums;
  }
  /* Pila de entregables: el actual adelante, los de etapas hechas corridos atrás,
     los que faltan esperan abajo, invisibles. */
  .doc-slot {
    position: absolute;
    inset: 96px 0 auto 48px;
    opacity: 0;
    transform: translateY(80px) rotate(2deg);
    transition: opacity 500ms var(--ease-out), transform 800ms var(--ease-out), filter 500ms var(--ease-out);
    pointer-events: none;
  }
  .doc-slot.before {
    --k: 1;
    z-index: calc(10 - var(--k));
    opacity: 1;
    filter: brightness(calc(1 - var(--k) * 0.14));
    transform: translate(calc(var(--k) * -16px), calc(var(--k) * -22px)) scale(calc(1 - var(--k) * 0.05));
  }
  .doc-slot.current {
    z-index: 20;
    opacity: 1;
    transform: none;
  }

  @media (max-width: 640px) {
    .body {
      padding-left: 0;
    }
    .stages {
      gap: 20px;
    }
    .rail {
      display: none;
    }
    .stages {
      gap: 20px;
    }
    dl {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
    }
  }
</style>
