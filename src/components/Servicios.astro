---
// Qué vendemos, en una mirada: cinco servicios con nombre y una línea cada uno.
// Lista con divisores, no tarjetas: se lee como el índice de una empresa, no como un catálogo.
const servicios = [
  {
    t: "Sistemas de gestión",
    d: "Stock, pedidos, turnos, clientes o facturación en un solo lugar, con lo que necesita ver cada persona de tu equipo.",
  },
  {
    t: "Apps web y móviles",
    d: "Para tu equipo o para tus clientes, en la computadora o en el celular, conectadas al mismo sistema.",
  },
  {
    t: "Integraciones y automatización",
    d: "Conectamos los programas que ya usás y hacemos solos los trámites que hoy alguien repite a mano.",
  },
  {
    t: "Dispositivos conectados (IoT)",
    d: "Sensores y equipos conectados a tu sistema, para medir y controlar lo que hoy se anota a mano.",
  },
  {
    t: "Mantenimiento",
    d: "Después de la entrega seguimos: soporte, mejoras y copias de seguridad con un abono mensual.",
  },
];
---

<section class="section" id="servicios" aria-labelledby="servicios-title">
  <div class="wrap">
    <div class="sec-head">
      <h2 id="servicios-title" data-reveal>Qué hacemos.</h2>
      <p data-reveal style="--d:1">
        Software y tecnología a medida para pymes de Córdoba y de todo el país. Partimos de cómo trabaja tu
        equipo hoy y construimos lo que hace falta.
      </p>
    </div>
    <ul class="list">
      {
        servicios.map((s, i) => (
          <li data-reveal style={`--d:${i + 1}`}>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    position: relative;
    display: grid;
    gap: 10px;
    align-content: start;
    padding-top: 20px;
  }
  /* Filete de arriba: se dibuja de izquierda a derecha al aparecer y se vuelve naranja en el
     servicio que estás mirando. */
  li::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: var(--ink);
    transform-origin: left;
    transition: background-color 220ms var(--ease-out),
      transform 1100ms var(--ease-out) calc(var(--d, 0) * 90ms + 120ms);
  }
  :global(html.js:not(.reduce)) li:not(.in)::before {
    transform: scaleX(0);
  }
  li:hover::before {
    background: var(--signal);
  }
  h3 {
    font-size: var(--fs-lg);
  }
  p {
    color: var(--ink-soft);
  }
  @media (max-width: 1280px) {
    .list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 1000px) {
    .list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 40px;
    }
  }
  @media (max-width: 560px) {
    .list {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
  }
</style>
