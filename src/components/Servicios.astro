---
// Qué vendemos: cada servicio se nombra por lo que le resuelve al dueño, con su categoría al lado
// para quien la busque así. "Consultar por esto" lleva al formulario con el pedido escrito.
const servicios = [
  {
    t: "Ordenar tu negocio",
    tipo: "Sistemas de gestión",
    d: "Stock, pedidos, turnos, clientes o facturación en un solo lugar, con lo que necesita ver cada persona de tu equipo.",
  },
  {
    t: "Atender mejor a tus clientes",
    tipo: "Sitios, apps web y móviles",
    d: "Un sitio, un portal o una app para que te encuentren, pidan o reserven sin tener que llamarte.",
  },
  {
    t: "Sacarte tareas de encima",
    tipo: "Integraciones y automatización",
    d: "Conectamos los programas que ya usás y hacemos solos los trámites que hoy alguien repite a mano.",
  },
  {
    t: "Saber qué pasa en tu planta",
    tipo: "Dispositivos conectados (IoT)",
    d: "Sensores y equipos conectados a tu sistema, para medir y controlar lo que hoy se anota a mano. Ya armamos paneles con ESP32 y equipos con Raspberry Pi.",
  },
  {
    t: "Que todo siga andando",
    tipo: "Mantenimiento",
    d: "Después de la entrega seguimos: soporte, mejoras y copias de seguridad con un abono mensual.",
  },
];
---

<section class="section tint" id="servicios" aria-labelledby="servicios-title">
  <div class="wrap layout">
    <div class="sec-head">
      <h2 id="servicios-title" data-reveal>Qué hacemos.</h2>
      <p data-reveal style="--d:1">
        Software y tecnología a medida para pymes de Córdoba y de todo el país. Partimos de cómo trabaja tu equipo hoy
        y construimos lo que hace falta.
      </p>
      <p class="honest" data-reveal style="--d:2">
        Si un programa que ya existe te alcanza, te lo decimos. Preferimos que no gastes de más.
      </p>
    </div>
    <ul class="list">
      {
        servicios.map((s, i) => (
          <li data-reveal style={`--d:${i + 1}`}>
            <div>
              <h3>{s.t}</h3>
              <p class="tipo">{s.tipo}</p>
            </div>
            <div class="d">
              <p>{s.d}</p>
              <a href="#contacto" data-pedir={s.t}>Consultar por esto<span class="sr-only">: {s.t}</span></a>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import { pedirContacto } from "../config";
  // Con JS, el link además deja el pedido escrito. Sin JS, igual lleva al formulario.
  document.querySelectorAll<HTMLAnchorElement>("[data-pedir]").forEach((a) =>
    a.addEventListener("click", (e) => {
      e.preventDefault();
      pedirContacto(`Me interesa: ${a.dataset.pedir}`);
    }),
  );
</script>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 8fr);
    gap: 32px clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .sec-head {
    position: sticky;
    top: 120px;
    margin-bottom: 0;
  }
  .list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--line);
  }
  li {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 8px 32px;
    padding-block: 22px;
  }
  .honest {
    padding-left: 14px;
    border-left: 1px solid var(--signal);
    font-size: var(--fs-md);
  }
  .tipo {
    margin-top: 4px;
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .d a {
    display: inline-block;
    margin-top: 2px;
    padding-block: 8px;
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration-color: var(--signal);
  }
  /* Filete de arriba: se dibuja de izquierda a derecha al aparecer y se vuelve naranja en el
     servicio que estás mirando. */
  li::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--ink);
    transform-origin: left;
    transition: background-color 220ms var(--ease-out),
      transform 1100ms var(--ease-out) calc(var(--d, 0) * 90ms + 120ms);
  }
  :global(html.js:not(.reduce)) li:not(.in)::before {
    transform: scaleX(0);
  }
  @media (hover: hover) {
    li:hover::before {
      background: var(--signal);
    }
  }
  h3 {
    font-size: var(--fs-xl);
  }
  p {
    color: var(--ink-soft);
  }
  @media (max-width: 1000px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .sec-head {
      position: static;
    }
  }
  @media (max-width: 640px) {
    li {
      grid-template-columns: minmax(0, 1fr);
      padding-block: 20px;
    }
  }
</style>
