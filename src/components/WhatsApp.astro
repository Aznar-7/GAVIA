---
// Acceso fijo a WhatsApp, el canal por el que escribe la mayoría de las pymes. Solo existe si
// hay número configurado en config.ts. Aparece después del hero y se esconde en Contacto,
// donde ya están todas las formas de escribirnos.
import { whatsappUrl } from "../config";
const wa = whatsappUrl();
---

{
  wa && (
    <a class="wa" href={wa} target="_blank" rel="noopener" data-wa hidden>
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path d="M4 4h16v12H10l-6 5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="miter"></path>
        <rect x="8" y="9" width="2.4" height="2.4" fill="var(--signal)"></rect>
        <rect x="12" y="9" width="2.4" height="2.4" fill="currentColor"></rect>
      </svg>
      <span>WhatsApp</span>
    </a>
  )
}

<script>
  const wa = document.querySelector<HTMLElement>("[data-wa]");
  const hero = document.getElementById("top");
  const contacto = document.getElementById("contacto");
  if (wa && hero && contacto) {
    const seen = new Map<Element, boolean>();
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) seen.set(e.target, e.isIntersecting);
      wa.hidden = !!seen.get(hero) || !!seen.get(contacto);
    });
    io.observe(hero);
    io.observe(contacto);
  }
</script>

<style>
  .wa {
    position: fixed;
    right: clamp(16px, 3vw, 32px);
    bottom: clamp(16px, 3vw, 32px);
    z-index: 40;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 18px;
    border: 2px solid var(--paper);
    outline: 2px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    font-weight: 700;
    text-decoration: none;
    transition: background 200ms var(--ease-out), color 200ms var(--ease-out);
  }
  .wa:hover {
    background: var(--paper);
    color: var(--ink);
  }
  @media (max-width: 560px) {
    .wa span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    .wa {
      padding: 0 14px;
    }
  }
</style>
