---
// Lo que ya construimos: dos casos reales, cada uno con su captura a sangre, y las piezas de
// hardware que respaldan el servicio de IoT.
// Cada dato sale de los repositorios y la documentación de cada proyecto: no sumar números de
// uso sin un dato real. Las fotos de la captura de Propier son de ejemplo, y el sitio lo aclara.
import { Image } from "astro:assets";
import capPropier from "../assets/propier/home.png";
import capInscribot from "../assets/utnhub/inscribot.png";

const casos = [
  {
    nombre: "Propier Inmuebles",
    estado: "En desarrollo",
    vivo: false,
    resumen: "Una inmobiliaria de Córdoba que se había quedado sin sitio y no usaba ningún sistema.",
    img: capPropier,
    alt: "Portada del sitio de Propier: casa con jardín, buscador de propiedades y una propiedad destacada con su precio.",
    nota: "Fotos de ejemplo, hasta que esté cargada la cartera real.",
    datos: [
      { t: "Qué hacemos", d: "El sitio público, con buscador y fichas, y el panel desde donde publican cada propiedad." },
      { t: "Antes de programar", d: "Estudiamos 21 sitios inmobiliarios y escribimos requerimientos, casos de uso, arquitectura y seguridad." },
      { t: "Para que dure", d: "Con el tráfico previsto corre en planes gratuitos: sin gasto mensual de servidores." },
    ],
  },
  {
    nombre: "UTN Hub",
    estado: "En uso",
    vivo: true,
    resumen: "La plataforma de los estudiantes de la UTN Córdoba, con un robot que hace los trámites solo.",
    img: capInscribot,
    alt: "InscriBot en UTN Hub: el registro de actividad muestra cómo encuentra un cupo y confirma la inscripción solo.",
    link: { href: "https://utnhub.com.ar", label: "Visitar utnhub.com.ar" },
    datos: [
      { t: "Trámites solos", d: "InscriBot vigila el sistema de la facultad, anota al estudiante apenas se libera un cupo y avisa por Telegram." },
      { t: "Sistemas conectados", d: "UTN Manager lee el aula virtual, detecta qué cambió y agenda las entregas en el calendario." },
      { t: "Hecho para durar", d: "Más de 500 pruebas automáticas, claves cifradas y tecnología probada: React, Django y PostgreSQL." },
    ],
  },
];

const hardware = [
  { t: "SenseBoard", d: "Panel IoT para equipos con ESP32: temperatura, humedad, alertas e historial.", href: "https://github.com/Aznar-7/SenseBoard_Front" },
  { t: "AutoFull", d: "Robot Wi-Fi con Arduino y ESP32, control web y sensores.", href: "https://github.com/Aznar-7/AutoFull" },
  { t: "Eco Records", d: "Un tocadiscos NFC hecho con Raspberry Pi.", href: "https://github.com/Aznar-7/proyect-ecoRecords-pi" },
];
---

<section class="section" id="proyectos" aria-labelledby="proyectos-title">
  <div class="wrap">
    <div class="sec-head">
      <h2 id="proyectos-title" data-reveal>Lo que ya construimos.</h2>
      <p data-reveal style="--d:1">Un cliente real y un sistema nuestro en uso. Mirá qué hicimos y cómo.</p>
    </div>

    {
      casos.map((c, i) => (
        <article class:list={["case", { flip: i % 2 === 1 }]}>
          <div class="text" data-reveal>
            <h3>{c.nombre} <span class:list={["pill", { live: c.vivo }]}>{c.estado}</span></h3>
            <p class="lead">{c.resumen}</p>
            <dl>
              {c.datos.map((d) => (
                <div>
                  <dt>{d.t}</dt>
                  <dd>{d.d}</dd>
                </div>
              ))}
            </dl>
            {c.link && (
              <a class="btn secondary" href={c.link.href} target="_blank" rel="noopener">
                {c.link.label}<span class="sr-only"> (se abre en otra pestaña)</span>
              </a>
            )}
          </div>
          <figure class="shot" data-reveal>
            <Image src={c.img} alt={c.alt} widths={[700, 1100, 1440]} sizes="(max-width: 960px) 96vw, 62vw" loading="lazy" />
            {c.nota && <figcaption>{c.nota}</figcaption>}
          </figure>
        </article>
      ))
    }

    <div class="iron">
      <h3 data-reveal>Y del lado del hardware</h3>
      <ul>
        {
          hardware.map((h, i) => (
            <li data-reveal style={`--d:${i + 1}`}>
              <a href={h.href} target="_blank" rel="noopener">
                {h.t}<span class="sr-only"> (se abre en otra pestaña)</span>
              </a>
              <p>{h.d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  #proyectos {
    overflow-x: clip;
  }
  /* Cada caso: texto de un lado y la captura a sangre, que se va por el borde de la pantalla. */
  .case {
    --bleed: calc(var(--gutter) * -1 - max(0px, (100vw - var(--max)) / 2));
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 8fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }
  .case + .case {
    margin-top: clamp(64px, 8vw, 112px);
  }
  .flip {
    grid-template-columns: minmax(0, 8fr) minmax(0, 5fr);
  }
  .flip .text {
    order: 2;
  }
  .text {
    display: grid;
    gap: 16px;
    justify-items: start;
  }
  h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    font-size: var(--fs-2xl);
  }
  .lead {
    font-size: var(--fs-lg);
    color: var(--ink-soft);
  }
  dl {
    display: grid;
    width: 100%;
    margin: 8px 0;
  }
  dl > div {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 5fr);
    gap: 4px 20px;
    padding-block: 14px;
    border-top: 1px solid var(--line);
  }
  dt {
    font-weight: 700;
    font-size: var(--fs-sm);
    line-height: 1.5;
  }
  dd {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--ink-soft);
  }
  .shot {
    margin: 0 var(--bleed) 0 0;
    min-width: 0;
  }
  .flip .shot {
    margin: 0 0 0 var(--bleed);
  }
  .shot :global(img) {
    width: 100%;
    height: auto;
    box-shadow: var(--shadow);
  }
  figcaption {
    margin-top: 10px;
    font-size: var(--fs-sm);
    color: var(--muted);
  }

  .iron {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 9fr);
    gap: 24px clamp(32px, 5vw, 80px);
    margin-top: clamp(64px, 8vw, 112px);
    padding-top: 32px;
    border-top: 2px solid var(--ink);
  }
  .iron h3 {
    font-size: var(--fs-xl);
  }
  .iron ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .iron a {
    display: inline-block;
    margin-block: -6px;
    padding-block: 6px;
    font-weight: 700;
    text-decoration-color: var(--line-strong);
  }
  .iron p {
    margin-top: 4px;
    font-size: var(--fs-sm);
    color: var(--ink-soft);
  }

  @media (max-width: 960px) {
    .case,
    .flip {
      grid-template-columns: minmax(0, 1fr);
    }
    .flip .text {
      order: 0;
    }
    .flip .shot {
      margin: 0 var(--bleed) 0 0;
    }
    .iron {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 640px) {
    .iron ul {
      grid-template-columns: minmax(0, 1fr);
    }
    dl > div {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
