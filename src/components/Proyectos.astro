---
// Lo que ya construimos. UTN Hub va como caso completo: qué hace y qué significa eso para
// una empresa (es la prueba de las automatizaciones e integraciones que vendemos).
// Todo lo que dice sale del código de UTN Hub; no sumar números de uso sin un dato real.
const caso = {
  nombre: "UTN Hub",
  estado: "Software · en uso",
  href: "https://utnhub.com.ar",
  sitio: "utnhub.com.ar",
  texto:
    "Plataforma para estudiantes de la UTN Córdoba: materias, calendario, foros y materiales en un solo lugar, más dos robots que trabajan solos.",
  hace: [
    {
      t: "Un robot que se inscribe solo",
      d: "InscriBot vigila el Sysacad y te anota en la materia apenas se libera un cupo. Avisa por Telegram con una captura.",
      empresa: "Ese trámite que alguien de tu equipo repite a mano todos los días, hecho solo.",
    },
    {
      t: "Conectado a sistemas que ya existen",
      d: "UTN Manager lee el aula virtual y Autogestión, detecta qué cambió, avisa y agenda las entregas en el calendario.",
      empresa: "Los sistemas que ya usás, conectados entre sí, sin cargar dos veces lo mismo.",
    },
    {
      t: "La gestión de todos los días",
      d: "Foros por materia, materiales compartidos, tableros de proyecto y permutas de comisión con emparejamiento automático.",
      empresa: "Pedidos, stock, turnos o lo que maneje tu equipo, en un solo sistema.",
    },
  ],
  ficha: ["React", "Django", "PostgreSQL", "Redis", "Celery", "Bot de Telegram", "Más de 300 pruebas automáticas", "Credenciales cifradas"],
};

const proyectos = [
  {
    nombre: "Flety",
    estado: "Producto propio · en desarrollo",
    texto:
      "Plataforma para que los camiones no vuelvan vacíos: el transportista publica su ruta y encuentra cargas en su camino, en toda la Argentina.",
    detalle: ["App móvil", "Mapas", "Matching de rutas"],
    href: "#flety",
  },
];
---

<section class="section" id="proyectos" aria-labelledby="proyectos-title">
  <div class="wrap">
    <div class="sec-head">
      <h2 id="proyectos-title">Lo que ya construimos.</h2>
      <p>Somos un estudio nuevo y preferimos mostrarte trabajo real antes que promesas. Esto es lo que hicimos y lo que estamos construyendo.</p>
    </div>

    <article class="case" aria-labelledby="caso-title">
      <header class="case-head">
        <h3 id="caso-title"><a href={caso.href} target="_blank" rel="noopener">{caso.nombre}</a></h3>
        <span class="label">{caso.estado}</span>
        <a class="site" href={caso.href} target="_blank" rel="noopener">
          {caso.sitio}
          <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 9l6-6M4 3h5v5"></path></svg>
        </a>
      </header>
      <div class="case-body">
        <p class="case-lead">{caso.texto}</p>
        <ol class="does">
          {
            caso.hace.map((h) => (
              <li>
                <h4>{h.t}</h4>
                <p>{h.d}</p>
                <p class="empresa">
                  <span class="label">En tu empresa</span>
                  {h.empresa}
                </p>
              </li>
            ))
          }
        </ol>
        <ul class="tags ficha" aria-label="Cómo está hecho">
          {caso.ficha.map((f) => <li>{f}</li>)}
        </ul>
      </div>
    </article>

    <ul class="log">
      {
        proyectos.map((p) => (
          <li>
            <div class="head">
              <h3>
                <a href={p.href}>{p.nombre}</a>
              </h3>
              <span class="label">{p.estado}</span>
            </div>
            <p>{p.texto}</p>
            <ul class="tags">
              {p.detalle.map((d) => <li>{d}</li>)}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Caso: una hoja blanca sobre el papel, como el acta y las vistas previas de Proceso. */
  .case {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 24px 48px;
    padding: clamp(24px, 4vw, 48px);
    background: var(--white);
    border: 2px solid var(--ink);
  }
  .case-head {
    display: grid;
    gap: 8px;
    align-content: start;
  }
  .case-head h3 {
    font-size: var(--fs-2xl);
  }
  .case-body {
    display: grid;
    gap: 28px;
  }
  .case-lead {
    max-width: 56ch;
    font-size: var(--fs-lg);
    color: var(--ink-soft);
  }
  .does {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--ink);
  }
  .does li {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 5fr) minmax(0, 4fr);
    gap: 8px 28px;
    padding: 20px 0;
    border-bottom: 1px solid var(--rule-strong);
  }
  .does h4 {
    margin: 0;
    font: 700 var(--fs-md) / 1.35 var(--body);
  }
  .does p {
    color: var(--ink-soft);
  }
  .does .empresa {
    display: grid;
    gap: 4px;
    color: var(--ink);
    font-weight: 600;
  }
  .tags.ficha {
    justify-content: start;
  }

  .log {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .log > li {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 5fr) minmax(0, 3fr);
    gap: 16px 48px;
    align-items: start;
    padding: 36px 0;
    border-bottom: 1px solid var(--rule-strong);
    transition: background-color 220ms var(--ease-out);
  }
  .log > li:hover {
    background: linear-gradient(90deg, var(--white), transparent 85%);
  }
  .head {
    display: grid;
    gap: 8px;
  }
  h3 {
    font-size: var(--fs-xl);
    transition: color 220ms var(--ease-out), transform 300ms var(--ease-out);
  }
  h3 a {
    text-decoration: none;
  }
  .log > li:hover h3 {
    color: var(--signal-text);
    transform: translateX(8px);
  }
  .site {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding-block: 4px;
    font-weight: 600;
    font-size: var(--fs-sm);
    text-decoration-color: var(--signal);
  }
  .site svg {
    width: 11px;
    height: 11px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
  }
  .log > li > p {
    font-size: var(--fs-lg);
    color: var(--ink-soft);
  }
  /* Tipos y tecnologías como una línea de rótulos, no como chips. */
  .tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: end;
    gap: 6px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
    font: 600 0.8rem/1.4 var(--body);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  @media (max-width: 960px) {
    .case,
    .does li {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 860px) {
    .log > li {
      grid-template-columns: minmax(0, 1fr);
    }
    .tags {
      justify-content: start;
    }
  }
</style>
