---
// Lo que ya construimos: solo trabajos que representan lo que ofrecemos hoy
// (software). Completar stack y links reales de cada uno.
const proyectos = [
  {
    nombre: "UTN Hub",
    estado: "Software · en uso",
    texto:
      "Sistema de gestión académica para estudiantes de la UTN, con varias áreas y un bot que automatiza las inscripciones a materias.",
    detalle: ["Backend", "Frontend", "Automatización"],
    href: "https://utnhub.com.ar",
    sitio: "utnhub.com.ar",
  },
  {
    nombre: "Flety",
    estado: "Producto propio · en desarrollo",
    texto:
      "Plataforma para que los camiones no vuelvan vacíos: el transportista publica su ruta y encuentra cargas en su camino, en toda la Argentina.",
    detalle: ["App móvil", "Mapas", "Matching de rutas"],
    href: "#flety",
    sitio: null,
  },
];
---

<section class="section" id="proyectos" aria-labelledby="proyectos-title">
  <div class="wrap">
    <div class="sec-head">
      <h2 id="proyectos-title">Lo que ya construimos.</h2>
      <p>Somos un estudio nuevo y preferimos mostrarte trabajo real antes que promesas. Esto es lo que hicimos y lo que estamos construyendo.</p>
    </div>

    <ul class="log">
      {
        proyectos.map((p) => (
          <li>
            <div class="head">
              <h3>
                {p.sitio ? (
                  <a href={p.href} target="_blank" rel="noopener">{p.nombre}</a>
                ) : (
                  <a href={p.href}>{p.nombre}</a>
                )}
              </h3>
              <span class="label">{p.estado}</span>
              {p.sitio && (
                <a class="site" href={p.href} target="_blank" rel="noopener">
                  {p.sitio}
                  <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 9l6-6M4 3h5v5" /></svg>
                </a>
              )}
            </div>
            <p>{p.texto}</p>
            <ul class="tags">
              {p.detalle.map((d) => <li>{d}</li>)}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .log {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--ink);
  }
  .log > li {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 5fr) minmax(0, 3fr);
    gap: 16px 48px;
    align-items: start;
    padding: 36px 0;
    border-bottom: 1px solid var(--rule-strong);
    transition: background-color 220ms var(--ease-out);
  }
  .log > li:hover {
    background: linear-gradient(90deg, var(--white), transparent 85%);
  }
  .head {
    display: grid;
    gap: 8px;
  }
  h3 {
    font-size: var(--fs-xl);
    transition: color 220ms var(--ease-out), transform 300ms var(--ease-out);
  }
  h3 a {
    text-decoration: none;
  }
  .log > li:hover h3 {
    color: var(--signal-text);
    transform: translateX(8px);
  }
  .site {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding-block: 4px;
    font-weight: 600;
    font-size: var(--fs-sm);
    text-decoration-color: var(--signal);
  }
  .site svg {
    width: 11px;
    height: 11px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
  }
  .log > li > p {
    font-size: var(--fs-lg);
    color: var(--ink-soft);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: end;
    gap: 6px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
    font: 600 0.8rem/1.4 var(--body);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  /* Tipos y tecnologías como una línea de rótulos, no como chips. */
  @media (max-width: 860px) {
    .log > li {
      grid-template-columns: minmax(0, 1fr);
    }
    .tags {
      justify-content: start;
    }
  }
</style>
