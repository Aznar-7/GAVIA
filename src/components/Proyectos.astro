---
// Lo que ya construimos: un recorrido por UTN Hub, software nuestro en uso. Cada pestaña es
// algo que una empresa necesita, con la captura real que lo prueba.
// Todo lo que dice sale del código de UTN Hub; no sumar números de uso sin un dato real.
import { Image } from "astro:assets";
import capInscribot from "../assets/utnhub/inscribot.png";
import capManager from "../assets/utnhub/utn-manager.png";
import capProyectos from "../assets/utnhub/proyectos.png";

const tabs = [
  {
    t: "Trámites que se hacen solos",
    empresa: "Ese trámite que alguien de tu equipo repite a mano todos los días lo hace un robot, y te avisa cuando terminó.",
    prueba: "InscriBot vigila el sistema de la facultad y anota al estudiante apenas se libera un cupo. Avisa por Telegram con una captura.",
    img: capInscribot,
    alt: "InscriBot en UTN Hub: el registro de actividad muestra cómo encuentra un cupo y confirma la inscripción solo.",
  },
  {
    t: "Tus sistemas, conectados",
    empresa: "Los programas que ya usás se pasan los datos entre sí. Nadie carga dos veces lo mismo.",
    prueba: "UTN Manager lee el aula virtual y la autogestión, detecta qué cambió y agenda las entregas en el calendario.",
    img: capManager,
    alt: "UTN Manager en UTN Hub: próximas entregas y novedades traídas del aula virtual, con botón para agendarlas.",
  },
  {
    t: "El día a día, en un lugar",
    empresa: "Pedidos, stock, turnos o lo que maneje tu equipo, en un sistema en vez de planillas y chats.",
    prueba: "Materias, materiales, foros, tableros de proyecto y cambios de comisión con emparejamiento automático.",
    img: capProyectos,
    alt: "Tablero de proyecto en UTN Hub: tareas por hacer, en curso, en revisión y hechas, con responsable y fecha.",
  },
];
const calidad = [
  { t: "Más de 500 pruebas automáticas", d: "Cada cambio se revisa solo antes de publicarse." },
  { t: "Datos de acceso cifrados", d: "Las claves que guarda el sistema no quedan a la vista de nadie." },
  { t: "Tecnología probada", d: "React, Django y PostgreSQL: cualquier programador puede seguirlo mañana." },
];
---

<section class="section" id="proyectos" aria-labelledby="proyectos-title">
  <div class="wrap">
    <div class="sec-head">
      <h2 id="proyectos-title" data-reveal>Lo que ya construimos.</h2>
      <p data-reveal style="--d:1">
        Software nuestro, en uso hoy. Mirá por dentro cómo resolvimos problemas parecidos a los de una empresa.
      </p>
    </div>

    <article class="tour" aria-labelledby="caso-title" data-tour data-reveal>
      <header class="tour-head">
        <div>
          <h3 id="caso-title">UTN Hub <span class="pill live">En uso</span></h3>
          <p>La plataforma de los estudiantes de la UTN Córdoba.</p>
        </div>
        <a class="btn secondary" href="https://utnhub.com.ar" target="_blank" rel="noopener">
          Visitar utnhub.com.ar<span class="sr-only"> (se abre en otra pestaña)</span>
        </a>
      </header>

      <div class="tabs" role="tablist" aria-label="Qué hace UTN Hub" data-js>
        {
          tabs.map((t, i) => (
            <button
              type="button"
              role="tab"
              class="tab tap"
              id={`tab-${i}`}
              aria-controls={`panel-${i}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
            >
              {t.t}
              <span class="bar" aria-hidden="true"></span>
            </button>
          ))
        }
      </div>

      {
        tabs.map((t, i) => (
          <div class="panel" role="tabpanel" id={`panel-${i}`} aria-labelledby={`tab-${i}`} data-off={i !== 0 ? "" : undefined}>
            <div class="text">
              <p class="gain">{t.empresa}</p>
              <p class="proof">
                <strong>En UTN Hub:</strong> {t.prueba}
              </p>
            </div>
            <figure class="shot">
              <Image src={t.img} alt={t.alt} widths={[700, 1100, 1500]} sizes="(max-width: 860px) 92vw, 760px" loading="lazy" />
            </figure>
          </div>
        ))
      }

      <ul class="quality">
        {
          calidad.map((c) => (
            <li>
              <strong>{c.t}</strong>
              <span>{c.d}</span>
            </li>
          ))
        }
      </ul>
    </article>

    <p class="hardware" data-reveal>
      Del lado del hardware también tenemos horas de banco: un tocadiscos con Raspberry Pi y un auto con Arduino.
    </p>
  </div>
</section>

<script>
  const tour = document.querySelector<HTMLElement>("[data-tour]");
  if (tour) {
    const tabs = [...tour.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...tour.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    let current = 0;

    const show = (i: number, focus = false) => {
      current = i;
      tabs.forEach((t, k) => {
        t.setAttribute("aria-selected", String(k === i));
        t.tabIndex = k === i ? 0 : -1;
      });
      panels.forEach((p, k) => p.toggleAttribute("data-off", k !== i));
      if (focus) tabs[i].focus();
    };

    tabs.forEach((t, i) => t.addEventListener("click", () => show(i)));
    tour.addEventListener("keydown", (e) => {
      if (!(e.target as Element).matches('[role="tab"]')) return;
      const n = tabs.length;
      const next = { ArrowRight: (current + 1) % n, ArrowLeft: (current + n - 1) % n, Home: 0, End: n - 1 }[e.key];
      if (next === undefined) return;
      e.preventDefault();
      show(next, true);
    });
  }
</script>

<style>
  .tour {
    display: grid;
    gap: 28px;
    padding: clamp(24px, 4vw, 48px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow);
  }
  .tour-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px 32px;
  }
  .tour-head h3 {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: var(--fs-2xl);
  }
  .tour-head p {
    margin-top: 4px;
    color: var(--ink-soft);
  }

  /* Pestañas: la activa lleva una barra naranja. */
  .tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-bottom: 1px solid var(--line);
  }
  .tab {
    position: relative;
    padding: 14px 4px 18px;
    border: 0;
    background: none;
    color: var(--muted);
    font: 700 var(--fs-md) / 1.3 var(--body);
    text-align: left;
    cursor: pointer;
    transition: color 200ms var(--ease-out);
  }
  .tab:hover,
  .tab[aria-selected="true"] {
    color: var(--ink);
  }
  .bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 3px;
    background: var(--signal);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 400ms var(--ease-out);
  }
  .tab[aria-selected="true"] .bar {
    transform: scaleX(1);
  }

  .hardware {
    margin-top: 28px;
    color: var(--ink-soft);
  }
  .panel {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
  }
  :global(html.js:not(.reduce)) .panel:not([data-off]) {
    animation: swap 600ms var(--ease-out);
  }
  @keyframes swap {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  .text {
    display: grid;
    gap: 16px;
  }
  .gain {
    font-size: var(--fs-xl);
    font-weight: 600;
    line-height: 1.35;
  }
  .proof {
    padding-left: 14px;
    border-left: 2px solid var(--line);
    font-size: var(--fs-sm);
    color: var(--ink-soft);
  }
  /* Todas las capturas ocupan lo mismo: cambiar de pestaña no mueve lo que está abajo. */
  .shot {
    margin: 0;
    aspect-ratio: 1600 / 870;
    overflow: hidden;
    background: var(--ink);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    line-height: 0;
  }
  .shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: top;
  }

  .quality {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin: 0;
    padding: 24px 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }
  .quality li {
    display: grid;
    gap: 4px;
    align-content: start;
  }
  .quality span {
    font-size: var(--fs-sm);
    color: var(--ink-soft);
  }

  @media (max-width: 860px) {
    .panel {
      grid-template-columns: minmax(0, 1fr);
    }
    .panel .shot {
      order: -1;
    }
    .quality {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }

  }
  @media (max-width: 560px) {
    .tabs {
      grid-template-columns: minmax(0, 1fr);
      border-bottom: 0;
    }
    .tab {
      padding: 12px 0 14px;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
