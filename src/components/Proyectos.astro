---
// Casos: prueba de lo que ofrecemos, no una galería. Mismo orden en los dos: quién es, qué le
// pasaba, qué hicimos y qué tiene hoy. Una captura por caso.
// Cada dato sale de los repositorios y la documentación de cada proyecto: no sumar números de
// uso sin un dato real. Las fotos de la captura de Propier son de ejemplo, y el sitio lo aclara.
import { Image } from "astro:assets";
import capFicha from "../assets/propier/ficha.png";
import capInicio from "../assets/utnhub/inicio.png";

const casos = [
  {
    nombre: "Propier Inmuebles",
    estado: "En desarrollo",
    vivo: false,
    quien: "Una inmobiliaria de Córdoba.",
    img: capFicha,
    alt: "Ficha de una casa en el sitio de Propier: fotos, precio, datos de la propiedad y botón de WhatsApp.",
    nota: "Fotos de ejemplo, hasta que esté cargada la cartera real.",
    datos: [
      { t: "Qué le pasaba", d: "Se había quedado sin sitio y no usaba ningún sistema." },
      { t: "Qué hacemos", d: "Un sitio con buscador y fichas, y un panel para publicar cada propiedad." },
      { t: "Cómo lo encaramos", d: "Estudiamos 21 sitios inmobiliarios y escribimos los requerimientos antes de programar." },
      { t: "Qué va a tener", d: "Con el tráfico previsto corre en planes gratuitos: sin gasto mensual de servidores." },
    ],
  },
  {
    nombre: "UTN Hub",
    estado: "En uso",
    vivo: true,
    quien: "Un sistema propio para los estudiantes de la UTN Córdoba.",
    img: capInicio,
    alt: "Pantalla de inicio de UTN Hub: avance de la carrera, agenda del día y próximos compromisos.",
    link: { href: "https://utnhub.com.ar", label: "Visitar utnhub.com.ar" },
    datos: [
      { t: "Qué pasaba", d: "Conseguir cupo en una materia era revisar el sistema a mano hasta que se liberara uno." },
      { t: "Qué hicimos", d: "Un robot que vigila el sistema, anota al estudiante y avisa por Telegram." },
      { t: "Cómo lo encaramos", d: "Lo fuimos sumando por partes: aula virtual, entregas y calendario en un solo lugar." },
      { t: "Qué tiene hoy", d: "Más de 500 pruebas automáticas revisan cada cambio antes de publicarlo." },
    ],
  },
];
---

<section class="section" id="casos" aria-labelledby="casos-title">
  <div class="wrap">
    <div class="sec-head">
      <h2 id="casos-title" data-reveal>Dos casos reales.</h2>
      <p data-reveal style="--d:1">Un cliente y un sistema propio en uso. Así resolvimos cada uno.</p>
    </div>

    <div class="cases">
      {
        casos.map((c, i) => (
          <article data-reveal style={`--d:${i}`}>
            <Image src={c.img} alt={c.alt} widths={[640, 960, 1400]} sizes="(max-width: 860px) 96vw, 46vw" loading="lazy" />
            <h3>{c.nombre} <span class:list={["pill", { live: c.vivo }]}>{c.estado}</span></h3>
            <p class="quien">{c.quien}</p>
            <dl>
              {c.datos.map((d) => (
                <div>
                  <dt>{d.t}</dt>
                  <dd>{d.d}</dd>
                </div>
              ))}
            </dl>
            {c.nota && <p class="nota">{c.nota}</p>}
            {c.link && (
              <a class="link" href={c.link.href} target="_blank" rel="noopener">
                {c.link.label}<span class="sr-only"> (se abre en otra pestaña)</span>
              </a>
            )}
          </article>
        ))
      }
    </div>

    <p class="mine" data-reveal>¿Tu caso se parece a alguno? <a href="#contacto">Contanoslo</a>.</p>
  </div>
</section>

<style>
  .cases {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px clamp(32px, 5vw, 72px);
    align-items: start;
  }
  article {
    display: grid;
    gap: 10px;
    justify-items: start;
  }
  article :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: left top;
    border-radius: var(--radius-sm);
    outline: 1px solid var(--line);
    outline-offset: -1px;
  }
  .nota {
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin-top: 10px;
    font-size: var(--fs-2xl);
  }
  h3 .pill {
    letter-spacing: 0;
  }
  .quien {
    font-size: var(--fs-lg);
    color: var(--ink-soft);
  }
  dl {
    width: 100%;
    margin: 8px 0 0;
  }
  dl > div {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 5fr);
    gap: 2px 20px;
    padding-block: 12px;
    border-top: 1px solid var(--line);
  }
  dt {
    font-weight: 600;
    font-size: var(--fs-sm);
    line-height: 1.6;
  }
  dd {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--ink-soft);
  }
  .link {
    margin-top: 4px;
    padding-block: 8px;
    font-weight: 600;
    text-decoration-color: var(--signal);
  }
  .mine {
    margin-top: 40px;
    font-size: var(--fs-lg);
    color: var(--ink-soft);
  }
  .mine a {
    display: inline-block;
    margin-block: -10px;
    padding-block: 10px;
    font-weight: 600;
    color: var(--ink);
  }
  @media (max-width: 860px) {
    .cases {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 480px) {
    dl > div {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
