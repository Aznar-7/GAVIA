---
// Lo que ya construimos. UTN Hub va como caso: se lee desde el lado del cliente (qué gana una
// empresa) y UTN Hub aparece como la prueba de que ya lo hicimos, no al revés.
// Todo lo que dice sale del código de UTN Hub; no sumar números de uso sin un dato real.
// Las capturas son del sistema real, con datos de prueba (src/assets/utnhub).
import { Image } from "astro:assets";
import capInscribot from "../assets/utnhub/inscribot.png";
import capManager from "../assets/utnhub/utn-manager.png";
import capProyectos from "../assets/utnhub/proyectos.png";
const caso = {
  nombre: "UTN Hub",
  estado: "En uso",
  href: "https://utnhub.com.ar",
  sitio: "utnhub.com.ar",
  texto:
    "Lo hicimos para los estudiantes de la UTN Córdoba: un sistema que se conecta con los de la facultad y hace trámites solo. Es lo mismo que armamos para una empresa.",
  hace: [
    {
      t: "Trámites que se hacen solos",
      empresa: "Ese trámite que alguien de tu equipo repite a mano todos los días lo hace un robot, y te avisa cuando terminó.",
      prueba: "InscriBot vigila el sistema de la facultad y anota al estudiante apenas se libera un cupo. Avisa por Telegram con una captura.",
      img: capInscribot,
      alt: "InscriBot en UTN Hub: el registro de actividad muestra cómo encuentra un cupo y confirma la inscripción solo.",
    },
    {
      t: "Tus sistemas, conectados",
      empresa: "Los programas que ya usás se pasan los datos entre sí. Nadie carga dos veces lo mismo.",
      prueba: "UTN Manager lee el aula virtual y la autogestión, detecta qué cambió y agenda las entregas en el calendario.",
      img: capManager,
      alt: "UTN Manager en UTN Hub: próximas entregas y novedades traídas del aula virtual, con botón para agendarlas.",
    },
    {
      t: "El día a día, en un solo lugar",
      empresa: "Pedidos, stock, turnos o lo que maneje tu equipo, en un sistema en vez de planillas y chats.",
      prueba: "Materias, materiales, foros, tableros de proyecto y cambios de comisión con emparejamiento automático.",
      img: capProyectos,
      alt: "Tablero de proyecto en UTN Hub: tareas por hacer, en curso, en revisión y hechas, con responsable y fecha.",
    },
  ],
  calidad: [
    { t: "Más de 300 pruebas automáticas", d: "Cada cambio se revisa solo antes de publicarse." },
    { t: "Datos de acceso cifrados", d: "Las claves que guarda el sistema no quedan a la vista de nadie." },
  ],
  stack: ["React", "Django", "PostgreSQL", "Redis", "Celery", "Telegram"],
};

const proyectos = [
  {
    nombre: "Flety",
    estado: "Producto propio, en desarrollo",
    texto:
      "Plataforma para que los camiones no vuelvan vacíos: el transportista publica su ruta y encuentra cargas en su camino, en toda la Argentina.",
    detalle: ["App móvil", "Mapas", "Matching de rutas"],
    href: "/flety",
  },
];
---

<section class="section" id="proyectos" aria-labelledby="proyectos-title">
  <div class="wrap">
    <div class="sec-head">
      <h2 id="proyectos-title" data-reveal>Lo que ya construimos.</h2>
      <p data-reveal style="--d:1">
        Preferimos mostrarte trabajo real antes que promesas. UTN Hub ya está en uso; además, buscamos problemas
        que se repiten en una industria y armamos productos propios, como Flety.
      </p>
    </div>

    <article class="case" aria-labelledby="caso-title" data-reveal>
      <header class="case-head">
        <div class="case-id">
          <h3 id="caso-title">{caso.nombre}</h3>
          <span class="pill live">{caso.estado}</span>
          <a class="site" href={caso.href} target="_blank" rel="noopener">
              {caso.sitio}
              <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 9l6-6M4 3h5v5"></path></svg>
          </a>
        </div>
        <p class="case-lead">{caso.texto}</p>
      </header>

      <div class="does" role="table" aria-label="Qué hace UTN Hub y qué significa para una empresa">
        <div class="does-head" role="row">
          <span role="columnheader" class="label">Para tu empresa</span>
          <span role="columnheader" class="label">Así se ve en UTN Hub</span>
        </div>
        {
          caso.hace.map((h) => (
            <div class="does-row" role="row">
              <div role="cell" class="gain">
                <h4>{h.t}</h4>
                <p>{h.empresa}</p>
                <p class="proof">
                  <span class="label">En UTN Hub</span>
                  {h.prueba}
                </p>
              </div>
              <figure role="cell" class="shot">
                <Image src={h.img} alt={h.alt} widths={[560, 900, 1400]} sizes="(max-width: 760px) 92vw, 640px" loading="lazy" />
              </figure>
            </div>
          ))
        }
      </div>

      <footer class="case-foot">
        <dl class="quality">
          {
            caso.calidad.map((c) => (
              <div>
                <dt>{c.t}</dt>
                <dd>{c.d}</dd>
              </div>
            ))
          }
        </dl>
        <p class="stack">Hecho con {caso.stack.slice(0, -1).join(", ")} y {caso.stack.at(-1)}.</p>
      </footer>
    </article>

    <ul class="log">
      {
        proyectos.map((p) => (
          <li>
            <div class="head">
              <h3>
                <a href={p.href}>{p.nombre}</a>
              </h3>
              <span class="pill">{p.estado}</span>
            </div>
            <p>{p.texto}</p>
            <a class="site" href={p.href}>Conocer {p.nombre}</a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Caso: una tarjeta blanca con borde suave. */
  .case {
    display: grid;
    gap: clamp(28px, 3vw, 40px);
    padding: clamp(24px, 4vw, 56px);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .case-head {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 16px 48px;
    align-items: end;
  }
  .case-id {
    display: grid;
    gap: 8px;
    justify-items: start;
  }
  .case-lead {
    max-width: 52ch;
    font-size: var(--fs-lg);
    color: var(--ink-soft);
  }
  .does {
    border-top: 1px solid var(--line);
  }
  .does-head,
  .does-row {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 16px 48px;
  }
  .does-head {
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }
  .does-row {
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
    align-items: start;
  }
  .gain {
    display: grid;
    gap: 10px;
    align-content: start;
  }
  .gain h4 {
    font-size: var(--fs-lg);
  }
  .gain p {
    font-size: var(--fs-md);
    color: var(--ink);
  }
  .proof {
    display: grid;
    gap: 4px;
    margin-top: 6px;
    padding-left: 14px;
    border-left: 2px solid var(--line);
    font-size: var(--fs-sm);
    color: var(--ink-soft);
  }
  .proof .label {
    color: var(--muted);
  }
  /* Captura real con borde suave. */
  .shot {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--paper);
    line-height: 0;
  }
  .shot img {
    width: 100%;
    height: auto;
    transition: transform 500ms var(--ease-out);
  }
  .does-row:hover .shot img {
    transform: scale(1.02);
  }
  .case-foot {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 20px 48px;
    align-items: end;
  }
  .quality {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px 28px;
    margin: 0;
  }
  .quality dt {
    font-weight: 700;
  }
  .quality dd {
    margin: 4px 0 0;
    font-size: var(--fs-sm);
    color: var(--ink-soft);
  }
  .stack {
    font-size: var(--fs-sm);
    color: var(--muted);
  }

  .log {
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }
  .log > li {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 6fr) auto;
    gap: 16px 48px;
    align-items: center;
    padding: clamp(24px, 3vw, 36px) clamp(24px, 4vw, 56px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .head {
    display: grid;
    gap: 8px;
    justify-items: start;
  }
  h3 {
    font-size: var(--fs-xl);
  }
  .case-id h3 {
    font-size: var(--fs-2xl);
  }
  h3 a {
    text-decoration: none;
  }
  .site {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding-block: 12px;
    font-weight: 600;
    font-size: var(--fs-sm);
    text-decoration-color: var(--signal);
  }
  .site svg {
    width: 11px;
    height: 11px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
  }
  .log > li > p {
    color: var(--ink-soft);
  }
  @media (max-width: 960px) {
    .case-head,
    .case-foot {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  /* Celular: cada fila es una unidad; la prueba va debajo, con su rótulo. */
  @media (max-width: 760px) {
    .case-lead {
      font-size: var(--fs-lg);
    }
    .does-head {
      display: none;
    }
    .does-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
      padding: 22px 0;
    }
    .quality {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 860px) {
    .log > li {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
