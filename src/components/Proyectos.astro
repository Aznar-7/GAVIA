---
// Lo que ya construimos: cada caso sigue el mismo orden. Quién es, dos pantallas reales y tres
// datos. Abajo, las piezas de hardware que respaldan el servicio de IoT.
// Cada dato sale de los repositorios y la documentación de cada proyecto: no sumar números de
// uso sin un dato real. Las fotos de las capturas de Propier son de ejemplo, y el sitio lo aclara.
import { Image } from "astro:assets";
import capFicha from "../assets/propier/ficha.png";
import capLista from "../assets/propier/lista.png";
import capInicio from "../assets/utnhub/inicio.png";
import capBot from "../assets/utnhub/inscribot-panel.png";

const casos = [
  {
    nombre: "Propier Inmuebles",
    estado: "En desarrollo",
    vivo: false,
    resumen: "Una inmobiliaria de Córdoba que se había quedado sin sitio y no usaba ningún sistema.",
    nota: "Fotos de ejemplo, hasta que esté cargada la cartera real.",
    pantallas: [
      { img: capFicha, alt: "Ficha de una casa en el sitio de Propier: fotos, precio, datos de la propiedad y botón de WhatsApp." },
      { img: capLista, alt: "Listado de propiedades en venta del sitio de Propier, con foto y precio." },
    ],
    datos: [
      { t: "Qué hacemos", d: "El sitio público, con buscador y fichas, y el panel desde donde publican cada propiedad." },
      { t: "Antes de programar", d: "Estudiamos 21 sitios inmobiliarios y escribimos requerimientos, casos de uso, arquitectura y seguridad." },
      { t: "Para que dure", d: "Con el tráfico previsto corre en planes gratuitos: sin gasto mensual de servidores." },
    ],
  },
  {
    nombre: "UTN Hub",
    estado: "En uso",
    vivo: true,
    resumen: "La plataforma de los estudiantes de la UTN Córdoba, con un robot que hace los trámites solo.",
    link: { href: "https://utnhub.com.ar", label: "Visitar utnhub.com.ar" },
    pantallas: [
      { img: capInicio, alt: "Pantalla de inicio de UTN Hub: avance de la carrera, agenda del día y próximos compromisos." },
      { img: capBot, alt: "InscriBot trabajando: escanea el sistema, detecta un cupo y confirma la inscripción.", entera: true },
    ],
    datos: [
      { t: "Trámites solos", d: "InscriBot vigila el sistema de la facultad, anota al estudiante apenas se libera un cupo y avisa por Telegram." },
      { t: "Sistemas conectados", d: "UTN Manager lee el aula virtual, detecta qué cambió y agenda las entregas en el calendario." },
      { t: "Hecho para durar", d: "Más de 500 pruebas automáticas, claves cifradas y tecnología probada: React, Django y PostgreSQL." },
    ],
  },
];

const hardware = [
  { t: "SenseBoard", d: "Panel IoT para equipos con ESP32: temperatura, humedad, alertas e historial.", href: "https://github.com/Aznar-7/SenseBoard_Front" },
  { t: "AutoFull", d: "Robot Wi-Fi con Arduino y ESP32, control web y sensores.", href: "https://github.com/Aznar-7/AutoFull" },
  { t: "Eco Records", d: "Un tocadiscos NFC hecho con Raspberry Pi.", href: "https://github.com/Aznar-7/proyect-ecoRecords-pi" },
];
---

<section class="section" id="proyectos" aria-labelledby="proyectos-title">
  <div class="wrap">
    <div class="sec-head">
      <h2 id="proyectos-title" data-reveal>Lo que ya construimos.</h2>
      <p data-reveal style="--d:1">Un cliente real y un sistema nuestro en uso. Mirá qué hicimos y cómo.</p>
    </div>

    {
      casos.map((c) => (
        <article class="case">
          <header data-reveal>
            <h3>{c.nombre} <span class:list={["pill", { live: c.vivo }]}>{c.estado}</span></h3>
            <div class="about">
              <p>{c.resumen}</p>
              {c.link && (
                <a href={c.link.href} target="_blank" rel="noopener">
                  {c.link.label}<span class="sr-only"> (se abre en otra pestaña)</span>
                </a>
              )}
            </div>
          </header>
          <div class="duo" data-reveal>
            {c.pantallas.map((p, i) => (
              <Image
                src={p.img}
                alt={p.alt}
                class={"entera" in p ? "entera" : undefined}
                widths={[640, 960, 1400]}
                sizes={i === 0 ? "(max-width: 760px) 100vw, 62vw" : "(max-width: 760px) 100vw, 44vw"}
                loading="lazy"
              />
            ))}
          </div>
          {c.nota && <p class="nota">{c.nota}</p>}
          <dl data-reveal>
            {c.datos.map((d) => (
              <div>
                <dt>{d.t}</dt>
                <dd>{d.d}</dd>
              </div>
            ))}
          </dl>
        </article>
      ))
    }

    <div class="iron">
      <h3 data-reveal>Y del lado del hardware</h3>
      <ul>
        {
          hardware.map((h, i) => (
            <li data-reveal style={`--d:${i + 1}`}>
              <a href={h.href} target="_blank" rel="noopener">
                {h.t}<span class="sr-only"> (se abre en otra pestaña)</span>
              </a>
              <p>{h.d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .case + .case {
    margin-top: clamp(72px, 9vw, 128px);
  }
  header {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 12px 8px;
    align-items: end;
    margin-bottom: clamp(20px, 2.4vw, 28px);
  }
  h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    font-size: var(--fs-2xl);
  }
  h3 .pill {
    letter-spacing: 0;
  }
  .about p {
    font-size: var(--fs-lg);
    line-height: 1.45;
    color: var(--ink-soft);
  }
  .about a {
    display: inline-block;
    margin-top: 4px;
    padding-block: 8px;
    font-weight: 700;
    text-decoration-color: var(--signal);
  }
  /* Dos pantallas de la misma altura, pegadas, en el ancho de la página. */
  .duo {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 8px;
  }
  .duo :global(img) {
    width: 100%;
    height: clamp(240px, 36vw, 560px);
    object-fit: cover;
    object-position: left top;
    border-radius: var(--radius-sm);
    outline: 1px solid var(--line);
    outline-offset: -1px;
  }
  /* Esta se ve completa: el fondo es el mismo de la captura, así no se notan los márgenes. */
  .duo :global(img.entera) {
    object-fit: contain;
    object-position: center;
    background: #0a0b0e;
  }
  .nota {
    margin-top: 10px;
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px clamp(24px, 4vw, 56px);
    margin: clamp(20px, 2.4vw, 28px) 0 0;
  }
  dt {
    font-weight: 700;
  }
  dd {
    margin: 4px 0 0;
    color: var(--ink-soft);
  }

  .iron {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: 24px clamp(32px, 5vw, 80px);
    margin-top: clamp(72px, 9vw, 128px);
    padding-top: 28px;
    border-top: 2px solid var(--ink);
  }
  .iron h3 {
    font-size: var(--fs-xl);
    letter-spacing: -0.015em;
  }
  .iron ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .iron a {
    display: inline-block;
    margin-block: -6px;
    padding-block: 6px;
    font-weight: 700;
    text-decoration-color: var(--line-strong);
  }
  .iron p {
    margin-top: 4px;
    font-size: var(--fs-sm);
    color: var(--ink-soft);
  }

  @media (max-width: 960px) {
    header,
    .iron {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 760px) {
    .duo {
      grid-template-columns: minmax(0, 1fr);
    }
    .duo :global(img) {
      height: 62vw;
    }
    dl,
    .iron ul {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
