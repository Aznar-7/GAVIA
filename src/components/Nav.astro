---
import Logo from "./Logo.astro";

const links = [
  { href: "#servicios", label: "Qué hacemos" },
  { href: "#como-trabajamos", label: "Cómo trabajamos" },
  { href: "#condiciones", label: "Condiciones" },
  { href: "#casos", label: "Casos" },
  { href: "#equipo", label: "Equipo" },
];
---

<header class="nav" data-nav>
  <div class="wrap row">
    <a href="#top" class="home" aria-label="Gavia, ir al inicio"><Logo size={24} tone="paper" /></a>
    <button class="menu" type="button" aria-expanded="false" aria-controls="nav-links" data-js>
      <span class="sr-only">Abrir menú</span>
      <span class="bars" aria-hidden="true"></span>
    </button>
    <nav aria-label="Secciones" id="nav-links">
      <ul>
        {links.map((l) => <li><a href={l.href} data-spy={l.href.slice(1)}>{l.label}</a></li>)}
      </ul>
    </nav>
    <button class="theme" type="button" aria-pressed="false" data-js>
      <span class="sr-only">Modo oscuro</span>
      <svg class="moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" /></svg>
      <svg class="sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M5.3 18.7l2.1-2.1M16.6 7.4l2.1-2.1" /></svg>
    </button>
    <a class="btn cta" href="#contacto">Contanos tu proyecto</a>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]")!;
  const menu = nav.querySelector<HTMLButtonElement>(".menu")!;
  const links = [...nav.querySelectorAll<HTMLAnchorElement>("[data-spy]")];

  const onScroll = () => nav.classList.toggle("scrolled", scrollY > 8);
  addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  // Sección activa: se marca el link de la sección que ocupa el centro de la pantalla.
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((l) => l.toggleAttribute("aria-current", l.dataset.spy === e.target.id));
      }
    },
    { rootMargin: "-50% 0px -50% 0px" },
  );
  document.querySelectorAll("main section[id]").forEach((s) => io.observe(s));

  // Tema claro u oscuro. El primero lo define Base.astro antes de pintar; acá se cambia y se recuerda.
  const html = document.documentElement;
  const tema = nav.querySelector<HTMLButtonElement>(".theme")!;
  const marcar = () => tema.setAttribute("aria-pressed", String(html.dataset.theme === "dark"));
  marcar();
  tema.addEventListener("click", () => {
    html.dataset.theme = html.dataset.theme === "dark" ? "light" : "dark";
    marcar();
    try {
      localStorage.setItem("tema", html.dataset.theme);
    } catch {}
  });

  // Menú de celular.
  const setOpen = (open: boolean) => {
    nav.classList.toggle("open", open);
    menu.setAttribute("aria-expanded", String(open));
    menu.querySelector(".sr-only")!.textContent = open ? "Cerrar menú" : "Abrir menú";
  };
  menu.addEventListener("click", () => setOpen(!nav.classList.contains("open")));
  links.forEach((l) => l.addEventListener("click", () => setOpen(false)));
  addEventListener("keydown", (e) => {
    if (e.key !== "Escape" || !nav.classList.contains("open")) return;
    setOpen(false);
    menu.focus();
  });
  addEventListener("click", (e) => !nav.contains(e.target as Node) && setOpen(false));
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--navy);
    color: var(--on-navy);
    border-bottom: 1px solid transparent;
    transition: border-color 200ms var(--ease-out);
  }
  .nav.scrolled {
    border-bottom-color: rgb(255 255 255 / 0.14);
  }
  .row {
    display: flex;
    align-items: center;
    gap: 32px;
    min-height: 72px;
  }
  .home {
    padding-block: 6px;
    text-decoration: none;
  }
  nav {
    margin-left: auto;
  }
  ul {
    display: flex;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Subrayado naranja que crece de izquierda a derecha al pasar el cursor y en la sección activa. */
  ul a {
    display: block;
    padding-block: 12px;
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--paper-soft);
    text-decoration: none;
    background: linear-gradient(var(--signal), var(--signal)) left calc(100% - 6px) / 0 2px no-repeat;
    transition: color 160ms var(--ease-out), background-size 260ms var(--ease-out);
  }
  ul a:hover,
  ul a[aria-current] {
    color: var(--on-navy);
    background-size: 100% 2px;
  }
  /* Blanco fijo: siempre a mano, sin competir con el naranja de cada sección. */
  .cta {
    min-height: 44px;
    padding-block: 0.6em;
    background: var(--on-navy);
    color: var(--on-signal);
    font-size: var(--fs-sm);
    white-space: nowrap;
  }
  @media (hover: hover) {
    .cta:hover {
      background: var(--paper-soft);
    }
  }
  .theme {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-inline: -8px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--paper-soft);
    cursor: pointer;
    transition: color 160ms var(--ease-out), background-color 160ms var(--ease-out);
  }
  .theme:hover {
    color: var(--on-navy);
    background: rgb(255 255 255 / 0.1);
  }
  .theme svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .sun,
  :global([data-theme="dark"]) .moon {
    display: none;
  }
  :global([data-theme="dark"]) .sun {
    display: block;
  }
  .menu {
    display: none;
  }

  @media (max-width: 960px) {
    .row {
      gap: 12px;
    }
    .cta {
      margin-left: auto;
    }
    .theme {
      order: 1;
      margin-inline: 0;
    }
    .menu {
      order: 2;
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border: 1px solid rgb(255 255 255 / 0.3);
      border-radius: var(--radius-sm);
      background: transparent;
      cursor: pointer;
    }
    .bars,
    .bars::before,
    .bars::after {
      display: block;
      width: 18px;
      height: 2px;
      background: var(--on-navy);
      transition: transform 260ms var(--ease-out), opacity 200ms;
    }
    .bars {
      position: relative;
    }
    .bars::before,
    .bars::after {
      content: "";
      position: absolute;
      left: 0;
    }
    .bars::before {
      top: -6px;
    }
    .bars::after {
      top: 6px;
    }
    .open .bars {
      background: transparent;
    }
    .open .bars::before {
      transform: translateY(6px) rotate(45deg);
    }
    .open .bars::after {
      transform: translateY(-6px) rotate(-45deg);
    }
    nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      margin: 0;
      background: var(--navy);
      border-bottom: 1px solid rgb(255 255 255 / 0.14);
      clip-path: inset(0 0 100% 0);
      visibility: hidden;
      transition: clip-path 300ms var(--ease-out), visibility 0s 300ms;
    }
    /* Cerrado, el menú no debe sumar alto: la barra es sticky y al final de la página
       el panel oculto estiraba el scroll con un hueco vacío debajo del pie. */
    .nav:not(.open) {
      overflow: clip;
      overflow-clip-margin: 2px;
    }
    .open nav {
      max-height: calc(100dvh - 72px);
      overflow-y: auto;
      clip-path: inset(0 0 0 0);
      visibility: visible;
      transition: clip-path 300ms var(--ease-out);
    }
    ul {
      flex-direction: column;
      gap: 0;
      padding: 8px var(--gutter) 16px;
    }
    ul a {
      display: block;
      padding: 14px 0;
      font-size: var(--fs-lg);
      border-bottom: 1px solid rgb(255 255 255 / 0.14);
      background: none;
    }
  }
  /* Celular: la acción vive en la barra de abajo (Atajos), bajo el pulgar. */
  @media (max-width: 640px) {
    .cta {
      display: none;
    }
    .theme {
      margin-left: auto;
    }
  }
</style>
