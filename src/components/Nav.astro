---
import Logo from "./Logo.astro";

const links = [
  { href: "#servicios", label: "Servicios" },
  { href: "#proyectos", label: "Proyectos" },
  { href: "#como-trabajamos", label: "Cómo trabajamos" },
  { href: "#equipo", label: "Equipo" },
  { href: "#preguntas", label: "Preguntas" },
];
---

<header class="nav" data-nav>
  <div class="wrap row">
    <a href="#top" class="home" aria-label="Gavia, ir al inicio"><Logo size={24} /></a>
    <button class="menu" type="button" aria-expanded="false" aria-controls="nav-links" data-js>
      <span class="sr-only">Abrir menú</span>
      <span class="bars" aria-hidden="true"></span>
    </button>
    <nav aria-label="Secciones" id="nav-links">
      <ul>
        {links.map((l) => <li><a href={l.href} data-spy={l.href.slice(1)}>{l.label}</a></li>)}
      </ul>
    </nav>
    <a class="btn cta" href="#contacto">Contanos tu proyecto</a>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]")!;
  const menu = nav.querySelector<HTMLButtonElement>(".menu")!;
  const links = [...nav.querySelectorAll<HTMLAnchorElement>("[data-spy]")];

  const onScroll = () => nav.classList.toggle("scrolled", scrollY > 8);
  addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  // Una sola acción naranja por pantalla: si hay otra a la vista, el botón de la barra se apaga.
  const cta = nav.querySelector<HTMLElement>(".cta")!;
  const naranjas = new Set<Element>();
  const ctaIo = new IntersectionObserver((entries) => {
    for (const e of entries) e.isIntersecting ? naranjas.add(e.target) : naranjas.delete(e.target);
    cta.classList.toggle("secondary", naranjas.size > 0);
  });
  document.querySelectorAll("main .btn:not(.secondary)").forEach((b) => ctaIo.observe(b));

  // Sección activa: se marca el link de la sección que ocupa el centro de la pantalla.
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((l) => l.toggleAttribute("aria-current", l.dataset.spy === e.target.id));
      }
    },
    { rootMargin: "-50% 0px -50% 0px" },
  );
  document.querySelectorAll("main section[id]").forEach((s) => io.observe(s));

  // Menú de celular.
  const setOpen = (open: boolean) => {
    nav.classList.toggle("open", open);
    menu.setAttribute("aria-expanded", String(open));
    menu.querySelector(".sr-only")!.textContent = open ? "Cerrar menú" : "Abrir menú";
  };
  menu.addEventListener("click", () => setOpen(!nav.classList.contains("open")));
  links.forEach((l) => l.addEventListener("click", () => setOpen(false)));
  addEventListener("keydown", (e) => {
    if (e.key !== "Escape" || !nav.classList.contains("open")) return;
    setOpen(false);
    menu.focus();
  });
  addEventListener("click", (e) => !nav.contains(e.target as Node) && setOpen(false));
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--white);
    border-bottom: 1px solid transparent;
    transition: border-color 200ms var(--ease-out);
  }
  .nav.scrolled {
    border-bottom-color: var(--line);
  }
  .row {
    display: flex;
    align-items: center;
    gap: 32px;
    min-height: 72px;
  }
  .home {
    padding-block: 6px;
    text-decoration: none;
  }
  nav {
    margin-left: auto;
  }
  ul {
    display: flex;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Subrayado naranja que crece de izquierda a derecha al pasar el cursor y en la sección activa. */
  ul a {
    display: block;
    padding-block: 12px;
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--ink-soft);
    text-decoration: none;
    background: linear-gradient(var(--signal), var(--signal)) left calc(100% - 6px) / 0 2px no-repeat;
    transition: color 160ms var(--ease-out), background-size 260ms var(--ease-out);
  }
  ul a:hover,
  ul a[aria-current] {
    color: var(--ink);
    background-size: 100% 2px;
  }
  ul a[aria-current] {
    font-weight: 700;
  }
  .cta {
    min-height: 44px;
    padding-block: 0.6em;
    font-size: var(--fs-sm);
    white-space: nowrap;
  }
  .menu {
    display: none;
  }

  @media (max-width: 960px) {
    .cta {
      margin-left: auto;
    }
    .menu {
      order: 1;
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border: 1px solid var(--line-strong);
      border-radius: var(--radius-sm);
      background: transparent;
      cursor: pointer;
    }
    .bars,
    .bars::before,
    .bars::after {
      display: block;
      width: 18px;
      height: 2px;
      background: var(--ink);
      transition: transform 260ms var(--ease-out), opacity 200ms;
    }
    .bars {
      position: relative;
    }
    .bars::before,
    .bars::after {
      content: "";
      position: absolute;
      left: 0;
    }
    .bars::before {
      top: -6px;
    }
    .bars::after {
      top: 6px;
    }
    .open .bars {
      background: transparent;
    }
    .open .bars::before {
      transform: translateY(6px) rotate(45deg);
    }
    .open .bars::after {
      transform: translateY(-6px) rotate(-45deg);
    }
    nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      margin: 0;
      background: var(--white);
      border-bottom: 1px solid var(--line);
      clip-path: inset(0 0 100% 0);
      visibility: hidden;
      transition: clip-path 300ms var(--ease-out), visibility 0s 300ms;
    }
    /* Cerrado, el menú no debe sumar alto: la barra es sticky y al final de la página
       el panel oculto estiraba el scroll con un hueco vacío debajo del pie. */
    .nav:not(.open) {
      overflow: clip;
      overflow-clip-margin: 2px;
    }
    .open nav {
      max-height: calc(100dvh - 72px);
      overflow-y: auto;
      clip-path: inset(0 0 0 0);
      visibility: visible;
      transition: clip-path 300ms var(--ease-out);
    }
    ul {
      flex-direction: column;
      gap: 0;
      padding: 8px var(--gutter) 16px;
    }
    ul a {
      display: block;
      padding: 14px 0;
      font-size: var(--fs-lg);
      border-bottom: 1px solid var(--line);
      background: none;
    }
  }
  /* Celular: la acción vive en la barra de abajo (Atajos), bajo el pulgar. */
  @media (max-width: 640px) {
    .cta {
      display: none;
    }
    .menu {
      margin-left: auto;
    }
  }
</style>
