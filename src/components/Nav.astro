---
// Barra flotante: una isla de vidrio arriba de todo. Sobre las secciones oscuras (las marcadas
// con data-tone="dark") se vuelve oscura para no cortar el fondo.
import Logo from "./Logo.astro";

const links = [
  { href: "#servicios", label: "Servicios" },
  { href: "#como-trabajamos", label: "Cómo trabajamos" },
  { href: "#proyectos", label: "Proyectos" },
  { href: "#equipo", label: "Equipo" },
  { href: "#preguntas", label: "Preguntas" },
];
---

<header class="nav on-dark" data-nav>
  <div class="island">
    <a href="#top" class="home" aria-label="Gavia, ir al inicio"><Logo size={22} /></a>
    <nav aria-label="Secciones" id="nav-links">
      <ul>
        {links.map((l) => <li><a href={l.href} data-spy={l.href.slice(1)}>{l.label}</a></li>)}
      </ul>
    </nav>
    <a class="btn cta" href="#contacto">Contanos tu proyecto</a>
    <button class="menu" type="button" aria-expanded="false" aria-controls="nav-links">
      <span class="sr-only">Abrir menú</span>
      <span class="bars" aria-hidden="true"></span>
    </button>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]")!;
  const menu = nav.querySelector<HTMLButtonElement>(".menu")!;
  const links = [...nav.querySelectorAll<HTMLAnchorElement>("[data-spy]")];
  const dark = [...document.querySelectorAll<HTMLElement>('[data-tone="dark"]')];

  // Tono: oscuro mientras la línea de la barra pasa por una sección oscura.
  let raf = 0;
  const tone = () => {
    raf = 0;
    const y = 40;
    const over = dark.some((s) => {
      const r = s.getBoundingClientRect();
      return r.top <= y && r.bottom >= y;
    });
    nav.classList.toggle("on-dark", over);
    nav.classList.toggle("scrolled", scrollY > 8);
  };
  const queue = () => (raf ||= requestAnimationFrame(tone));
  addEventListener("scroll", queue, { passive: true });
  addEventListener("resize", queue);
  tone();

  // Sección activa: se marca el link de la sección que ocupa el centro de la pantalla.
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((l) => l.toggleAttribute("aria-current", l.dataset.spy === e.target.id));
      }
    },
    { rootMargin: "-50% 0px -50% 0px" },
  );
  document.querySelectorAll("main section[id]").forEach((s) => io.observe(s));

  // Menú de celular.
  const setOpen = (open: boolean) => {
    nav.classList.toggle("open", open);
    menu.setAttribute("aria-expanded", String(open));
    menu.querySelector(".sr-only")!.textContent = open ? "Cerrar menú" : "Abrir menú";
  };
  menu.addEventListener("click", () => setOpen(!nav.classList.contains("open")));
  links.forEach((l) => l.addEventListener("click", () => setOpen(false)));
  addEventListener("keydown", (e) => e.key === "Escape" && setOpen(false));
</script>

<style>
  .nav {
    position: fixed;
    inset: 12px 0 auto;
    z-index: var(--z-nav);
    padding-inline: max(12px, calc(var(--gutter) - 20px));
    pointer-events: none;
  }
  .island {
    position: relative;
    display: flex;
    align-items: center;
    gap: 28px;
    max-width: calc(var(--max) - var(--gutter) * 2 + 40px);
    min-height: 60px;
    margin-inline: auto;
    padding: 8px 8px 8px 20px;
    border-radius: 14px;
    background: rgb(251 250 247 / 0.72);
    -webkit-backdrop-filter: saturate(1.8) blur(18px);
    backdrop-filter: saturate(1.8) blur(18px);
    box-shadow: inset 0 0 0 1px rgb(12 26 43 / 0.07), inset 0 1px 0 rgb(255 255 255 / 0.6),
      0 8px 24px -12px rgb(12 26 43 / 0.18);
    pointer-events: auto;
    transition: background-color 400ms var(--ease-out), box-shadow 400ms var(--ease-out);
  }
  .on-dark .island {
    background: rgb(15 31 51 / 0.55);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.09), inset 0 1px 0 rgb(255 255 255 / 0.06),
      0 12px 32px -12px rgb(0 0 0 / 0.5);
  }
  .home {
    text-decoration: none;
  }
  .home :global(.logo) {
    transition: color 400ms var(--ease-out);
  }
  .on-dark .home :global(.logo) {
    color: var(--white);
  }
  nav {
    margin-left: auto;
  }
  ul {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  ul a {
    position: relative;
    display: block;
    padding: 8px 14px;
    border-radius: 8px;
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 200ms var(--ease-out), background-color 200ms var(--ease-out);
  }
  ul a:hover {
    color: var(--ink);
    background: rgb(12 26 43 / 0.05);
  }
  /* Sección activa: el punto de paso naranja debajo del link. */
  ul a::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 1px;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    background: var(--signal);
    transform: scale(0);
    transition: transform 300ms var(--ease-spring);
  }
  ul a[aria-current] {
    color: var(--ink);
  }
  ul a[aria-current]::after {
    transform: scale(1);
  }
  .on-dark ul a {
    color: var(--paper-soft);
  }
  .on-dark ul a:hover,
  .on-dark ul a[aria-current] {
    color: var(--white);
    background: rgb(255 255 255 / 0.06);
  }
  .cta {
    min-height: 44px;
    padding: 0.6em 1.15em;
    font-size: var(--fs-sm);
    white-space: nowrap;
  }
  .menu {
    display: none;
  }

  @media (max-width: 1040px) {
    .cta {
      margin-left: auto;
    }
    .menu {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border: 0;
      border-radius: 10px;
      background: rgb(12 26 43 / 0.06);
      color: var(--ink);
      cursor: pointer;
      transition: background-color 300ms var(--ease-out), color 300ms var(--ease-out);
    }
    .on-dark .menu {
      background: rgb(255 255 255 / 0.08);
      color: var(--white);
    }
    .bars,
    .bars::before,
    .bars::after {
      display: block;
      width: 18px;
      height: 1.5px;
      background: currentColor;
      transition: transform 300ms var(--ease-out), opacity 200ms;
    }
    .bars {
      position: relative;
    }
    .bars::before,
    .bars::after {
      content: "";
      position: absolute;
      left: 0;
    }
    .bars::before {
      top: -6px;
    }
    .bars::after {
      top: 6px;
    }
    .open .bars {
      background: transparent;
    }
    .open .bars::before {
      transform: translateY(6px) rotate(45deg);
    }
    .open .bars::after {
      transform: translateY(-6px) rotate(-45deg);
    }
    nav {
      position: absolute;
      top: calc(100% + 8px);
      left: 0;
      right: 0;
      margin: 0;
      border-radius: 14px;
      background: var(--white);
      box-shadow: var(--shadow);
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
      transform-origin: top;
      visibility: hidden;
      transition: opacity 260ms var(--ease-out), transform 360ms var(--ease-out), visibility 0s 360ms;
    }
    .open nav {
      opacity: 1;
      transform: none;
      visibility: visible;
      transition: opacity 260ms var(--ease-out), transform 360ms var(--ease-out);
    }
    ul {
      flex-direction: column;
      gap: 0;
      padding: 8px;
    }
    ul a,
    .on-dark ul a {
      padding: 14px 14px;
      font-size: var(--fs-lg);
      color: var(--ink);
    }
    .on-dark ul a:hover,
    .on-dark ul a[aria-current] {
      color: var(--ink);
      background: var(--paper);
    }
    ul a::after {
      left: auto;
      right: 18px;
      top: 50%;
      bottom: auto;
      margin: -2px 0 0;
    }
  }
  /* Celular: la acción vive en la barra de abajo (Atajos), bajo el pulgar. */
  @media (max-width: 640px) {
    .nav {
      inset: 8px 0 auto;
      padding-inline: 8px;
    }
    .island {
      min-height: 56px;
      padding: 6px 6px 6px 16px;
    }
    .cta {
      display: none;
    }
    .menu {
      margin-left: auto;
    }
  }
</style>
