---
// Lo que firmamos: las condiciones de cada proyecto, publicadas.
// Cada línea es un compromiso real: no agregar nada que el equipo no vaya a cumplir.
// Pendiente de definir: plazo de la garantía y facturación (al constituir la empresa).
import { TEAM } from "../config";
const clausulas = [
  { t: "Precio cerrado por etapa", d: "Si algo cambia en el camino, lo cotizamos y lo aprobás antes de hacerlo." },
  { t: "El código es tuyo", d: "Con cada etapa pagada te entregamos su código y su documentación. Si frenás, te llevás lo que pagaste." },
  { t: "Garantía por escrito", d: "Cada propuesta dice qué cubre la garantía y cuánto dura, antes de que firmes." },
  { t: "Contrato antes de empezar", d: "Con alcance, plazos y precio por escrito." },
];
const firmas = [...TEAM.map((m) => m.nombre), "Vos"];
---

<section class="section tint" id="condiciones" aria-labelledby="condiciones-title">
  <div class="wrap">
    <div class="sec-head">
      <h2 id="condiciones-title" data-reveal>Lo que firmamos.</h2>
      <p data-reveal style="--d:1">Las condiciones de cada proyecto, a la vista antes de que hablemos.</p>
    </div>

    <div class="acta" data-reveal>
      <ol class="terms">
        {
          clausulas.map((c) => (
            <li>
              <h3>{c.t}</h3>
              <p>{c.d}</p>
            </li>
          ))
        }
      </ol>
      <ul class="firmas" aria-label="Firman">
        {firmas.map((f) => <li>{f}</li>)}
      </ul>
    </div>
    <div class="ask" data-reveal>
      <p>La primera reunión es gratis y sin compromiso.</p>
      <a class="btn" href="#contacto">Contanos tu proyecto</a>
    </div>
  </div>
</section>

<style>
  /* Se lee como un contrato: cláusulas numeradas y al pie las líneas de firma, con la tuya. */
  .acta {
    padding: clamp(24px, 5vw, 64px);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--white);
  }
  .terms {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 36px clamp(32px, 6vw, 96px);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: clausula;
  }
  .terms li {
    position: relative;
    padding-left: 44px;
    counter-increment: clausula;
  }
  .terms li::before {
    content: counter(clausula) ".";
    position: absolute;
    left: 0;
    top: 0;
    font: 700 var(--fs-xl) / 1.15 var(--display);
    color: var(--signal-text);
    font-variant-numeric: tabular-nums;
  }
  h3 {
    font-size: var(--fs-xl);
  }
  .terms p {
    margin-top: 6px;
    max-width: 46ch;
    color: var(--ink-soft);
  }
  .firmas {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
    margin: clamp(48px, 6vw, 72px) 0 0;
    padding: 0;
    list-style: none;
  }
  .firmas li {
    padding-top: 10px;
    border-top: 1px solid var(--ink);
    font-size: var(--fs-sm);
    font-weight: 600;
  }
  .firmas li:last-child {
    color: var(--signal-text);
  }
  .ask {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-top: 24px;
  }
  .ask p {
    font-weight: 600;
  }
  @media (max-width: 760px) {
    .terms {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
    .firmas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 40px 24px;
    }
    .ask .btn {
      width: 100%;
    }
  }
</style>
