---
// Lo que firmamos: presentado como un acta de bitácora, con cláusulas y firmas.
// Cada línea es un compromiso real: no agregar nada que el equipo no vaya a cumplir.
const clausulas = [
  { t: "Precio cerrado por etapa.", d: "Si algo cambia en el camino, lo cotizamos y lo aprobás antes de hacerlo." },
  { t: "El código es tuyo.", d: "Cuando terminás de pagar, te entregamos el repositorio completo y la documentación." },
  { t: "60 días de garantía.", d: "Si algo de lo acordado falla después de la entrega, lo corregimos sin costo." },
  { t: "Factura y contrato.", d: "Desde el primer día, con alcance y plazos por escrito." },
];
const firmantes = ["Vicente Aznar", "Agustín García", "Benjamín Viberti"];
const edicion = new Date().toLocaleDateString("es-AR", { month: "long", year: "numeric" });
---

<section class="section" id="condiciones" aria-labelledby="condiciones-title">
  <div class="wrap">
    <div class="sec-head">
      <h2 id="condiciones-title">Lo que firmamos.</h2>
      <p>Las condiciones que casi nadie publica. Nosotros las ponemos acá para que no haya sorpresas.</p>
    </div>

    <div class="acta">
      <header class="acta-head">
        <span class="coord">Acta de condiciones · Gavia</span>
        <span class="coord">Córdoba, {edicion}</span>
      </header>
      <ol>
        {
          clausulas.map((c) => (
            <li>
              <p>
                <strong>{c.t}</strong> {c.d}
              </p>
            </li>
          ))
        }
      </ol>
      <footer class="acta-foot">
        <p class="by">
          Lo firman <strong>{firmantes.slice(0, -1).join(", ")} y {firmantes.at(-1)}</strong>, en cada proyecto.
        </p>
        <svg class="seal" viewBox="0 0 96 96" aria-hidden="true">
          <rect x="3" y="3" width="90" height="90" fill="none" stroke="currentColor" stroke-width="2"></rect>
          <rect x="9" y="9" width="78" height="78" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="3 3"></rect>
          <path d="M66 27H27v42h42V51H51" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="square"></path>
          <rect x="43" y="43" width="15" height="15" fill="var(--signal)"></rect>
        </svg>
      </footer>
    </div>
  </div>
</section>

<style>
  .acta {
    background: var(--white);
    border: 2px solid var(--ink);
    padding: clamp(24px, 4vw, 56px);
  }
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 56px;
  }
  li {
    display: grid;
    gap: 8px;
    padding: 22px 0;
    border-bottom: 1px solid var(--rule-strong);
    background: var(--white);
  }
  li p {
    font-size: var(--fs-lg);
    color: var(--ink-soft);
    max-width: 44ch;
  }
  li strong {
    color: var(--ink);
  }
  .acta-head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 14px;
    border-bottom: 2px solid var(--ink);
    color: var(--muted);
  }
  .acta-foot {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-top: 36px;
  }
  .by {
    max-width: 52ch;
    color: var(--ink-soft);
  }
  .by strong {
    color: var(--ink);
  }
  .seal {
    flex: none;
    width: 88px;
    height: 88px;
    color: var(--ink);
    transform: rotate(-4deg);
    transition: transform 400ms var(--ease-out);
  }
  .acta:hover .seal {
    transform: rotate(0deg) scale(1.04);
  }
  @media (max-width: 760px) {
    ol {
      grid-template-columns: minmax(0, 1fr);
    }
    .acta-head {
      flex-direction: column;
      gap: 4px;
    }
  }
</style>
