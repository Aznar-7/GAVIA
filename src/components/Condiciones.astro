---
// Lo que firmamos: las condiciones de cada proyecto, publicadas.
// Cada línea es un compromiso real: no agregar nada que el equipo no vaya a cumplir.
// Pendiente de definir: plazo de la garantía y facturación (al constituir la empresa).
import { TEAM } from "../config";
const clausulas = [
  { t: "Precio cerrado por etapa", d: "Si algo cambia en el camino, lo cotizamos y lo aprobás antes de hacerlo." },
  { t: "El código es tuyo", d: "Cuando terminás de pagar, te entregamos el código completo y la documentación." },
  { t: "Garantía por escrito", d: "Cada propuesta dice qué cubre la garantía y cuánto dura, antes de que firmes." },
  { t: "Contrato antes de empezar", d: "Con alcance, plazos y precio por escrito." },
];
const firmantes = TEAM.map((m) => m.nombre);
const check = "M2 7l4 4 8-9";
---

<section class="section tint" id="condiciones" aria-labelledby="condiciones-title">
  <div class="wrap">
    <div class="sec-head">
      <h2 id="condiciones-title" data-reveal>Lo que firmamos.</h2>
      <p data-reveal style="--d:1">Las condiciones que casi nadie publica. Nosotros las ponemos acá para que no haya sorpresas.</p>
    </div>

    <div class="card spot" data-reveal>
      <ul class="terms">
        {
          clausulas.map((c) => (
            <li>
              <svg viewBox="0 0 16 14" width="18" height="16" aria-hidden="true"><path d={check} /></svg>
              <div>
                <h3>{c.t}</h3>
                <p>{c.d}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <div class="foot">
        <p class="by">
          Lo firman <strong>{firmantes.slice(0, -1).join(", ")} y {firmantes.at(-1)}</strong>, en cada proyecto.
        </p>
        <div class="ask">
          <p>La primera reunión es gratis y sin compromiso.</p>
          <a class="btn" href="#contacto">Contanos tu proyecto</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow);
  }
  .terms {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px 56px;
    margin: 0;
    padding: clamp(24px, 4vw, 48px);
    list-style: none;
  }
  li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 14px;
    align-items: start;
  }
  li svg {
    margin-top: 5px;
    fill: none;
    stroke: var(--success);
    stroke-width: 2.4;
  }
  h3 {
    font-size: var(--fs-lg);
  }
  li p {
    margin-top: 4px;
    max-width: 46ch;
    color: var(--ink-soft);
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 40px;
    padding: 24px clamp(24px, 4vw, 48px);
    border-top: 1px solid var(--line);
  }
  .by {
    color: var(--ink-soft);
  }
  .by strong {
    color: var(--ink);
  }
  .ask {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
  }
  .ask p {
    font-weight: 600;
  }
  @media (max-width: 760px) {
    .terms {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
    .ask,
    .ask .btn {
      width: 100%;
    }
  }
</style>
