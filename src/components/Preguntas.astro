---
// Lo que ya está en el acta de condiciones no se repite acá.
// Cuando haya un rango de precio confirmado, sumarlo a "¿Cuánto cuesta?".
const preguntas = [
  {
    q: "¿Cuánto cuesta?",
    a: "La primera charla es gratis y sin compromiso. El precio del sistema depende de qué tiene que hacer, cuántas personas lo usan y con qué se conecta. Después del relevamiento te damos un precio cerrado por etapa, así sabés cuánto vas a pagar antes de empezar. Pagás etapa por etapa y podés frenar después de cualquiera.",
  },
  { q: "¿Cuánto tarda?", a: "Un sistema chico lleva entre 4 y 8 semanas. Las fechas exactas van en la propuesta, etapa por etapa." },
  {
    q: "¿Por qué no contratar a un freelancer?",
    a: "Podés, y a veces conviene. Con nosotros tenés requerimientos por escrito, precio cerrado por etapa, entregas cada dos semanas, el código a tu nombre y alguien que lo mantiene después. Si un freelancer te da eso, también es una buena opción.",
  },
  {
    q: "¿Qué tengo que aportar yo?",
    a: "Nada técnico. Necesitamos a alguien que conozca cómo trabaja tu empresa, una o dos charlas al principio y tiempo para probar cada entrega y decirnos qué ajustar.",
  },
  {
    q: "¿Con qué tecnologías trabajan?",
    a: "Con tecnologías probadas y muy usadas, elegidas según lo que necesita tu sistema. Así cualquier programador puede seguirlo el día de mañana, aunque no sea con nosotros.",
  },
  {
    q: "¿Qué pasa después de la entrega?",
    a: "La garantía va por escrito en la propuesta: qué cubre y cuánto dura. Después, si querés, seguimos con un abono mensual de mantenimiento con soporte y mejoras.",
  },
  { q: "¿Trabajan fuera de Córdoba?", a: "Sí, con clientes de todo el país de forma remota. En Córdoba podemos ir a verte." },
];
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: preguntas.map((p) => ({
    "@type": "Question",
    name: p.q,
    acceptedAnswer: { "@type": "Answer", text: p.a },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

<section class="section" id="preguntas" aria-labelledby="preguntas-title">
  <div class="wrap layout">
    <div class="side">
      <h2 id="preguntas-title" data-reveal>Preguntas frecuentes.</h2>
      <div class="ask" data-reveal style="--d:1">
        <p>¿No está la tuya? Escribinos: te responde alguien del equipo, no un bot, en menos de un día hábil.</p>
        <a class="btn secondary" href="#contacto">Hacenos tu pregunta</a>
      </div>
    </div>
    <div class="list">
      {
        preguntas.map((p) => (
          <details>
            <summary>
              <span>{p.q}</span>
              <span class="mark" aria-hidden="true" />
            </summary>
            <p>{p.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 32px 64px;
    align-items: start;
  }
  .side {
    position: sticky;
    top: 120px;
    display: grid;
    gap: 28px;
    justify-items: start;
  }
  .ask {
    display: grid;
    gap: 16px;
    justify-items: start;
    max-width: 36ch;
  }
  .ask p {
    color: var(--ink-soft);
  }
  .list {
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 22px 0;
    font: 600 var(--fs-lg) / 1.35 var(--body);
    cursor: pointer;
    list-style: none;
    transition: color 160ms var(--ease-out);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--ink-soft);
  }
  /* Marca + dibujada con dos trazos; al abrir, el vertical se oculta y queda un −. */
  .mark {
    position: relative;
    flex: none;
    width: 18px;
    height: 18px;
  }
  .mark::before,
  .mark::after {
    content: "";
    position: absolute;
    background: currentColor;
    transition: transform 220ms var(--ease-out);
  }
  .mark::before {
    left: 0;
    right: 0;
    top: 8px;
    height: 2px;
  }
  .mark::after {
    top: 0;
    bottom: 0;
    left: 8px;
    width: 2px;
  }
  details[open] .mark::after {
    transform: scaleY(0);
  }
  details::details-content {
    block-size: 0;
    overflow: hidden;
    transition: block-size 320ms var(--ease-out), content-visibility 320ms allow-discrete;
  }
  details[open]::details-content {
    block-size: auto;
  }
  details p {
    max-width: 60ch;
    padding-bottom: 24px;
    color: var(--ink-soft);
  }
  @media (max-width: 860px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .side {
      display: contents;
    }
    /* En el celular la invitación va después de las preguntas. */
    .ask {
      order: 2;
    }
  }
</style>
