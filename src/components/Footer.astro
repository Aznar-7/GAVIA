---
// Pie de página como el margen de una carta náutica: el cartucho de título con la
// marca; la navegación y el contacto; y la vuelta al inicio. Se usa también en /flety,
// por eso los links a secciones llevan "/".
import Logo from "./Logo.astro";
import { CONTACT_EMAIL, SOCIAL, whatsappUrl } from "../config";
const year = new Date().getFullYear();
const wa = whatsappUrl();
const secciones = [
  { href: "/#servicios", label: "Servicios" },
  { href: "/#como-trabajamos", label: "Cómo trabajamos" },
  { href: "/#condiciones", label: "Condiciones" },
  { href: "/#proyectos", label: "Proyectos" },
  { href: "/#equipo", label: "Equipo" },
  { href: "/#preguntas", label: "Preguntas" },
];
---

<footer>
  <div class="wrap grid">
    <div class="title-block">
      <a href="/" class="brand" aria-label="Gavia, volver al inicio"><Logo size={34} tone="paper" /></a>
      <p class="mission">
        Estudio de desarrollo de software a medida. Diseñamos, construimos y mantenemos sistemas para empresas de
        Córdoba y de todo el país.
      </p>
    </div>

    <nav aria-label="Pie de página" class="col">
      <p class="label">Secciones</p>
      <ul>
        {secciones.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="col">
      <p class="label">Proyectos</p>
      <ul>
        <li><a href="/flety">Flety</a></li>
        <li><a href="https://utnhub.com.ar" target="_blank" rel="noopener">UTN Hub</a></li>
      </ul>
    </div>

    <div class="col">
      <p class="label">Contacto</p>
      <ul>
        <li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
        {wa && <li><a href={wa} target="_blank" rel="noopener">WhatsApp</a></li>}
        {SOCIAL.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
        <li>Córdoba, Argentina</li>
      </ul>
    </div>
  </div>

  <div class="wrap bottom">
    <p>© {year} Gavia. Hecho en Córdoba.</p>
    <a href="#top" class="up">
      <svg viewBox="0 0 24 40" aria-hidden="true"><path d="M12 38V4M4 12l8-8 8 8" fill="none" stroke="currentColor" stroke-width="2.4"></path></svg>
      Volver al inicio
    </a>
  </div>
</footer>

<style>
  footer {
    background: var(--ink);
    color: var(--paper);
  }
  footer ::selection {
    background: var(--signal);
    color: var(--ink);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) repeat(3, minmax(0, 2fr));
    gap: 40px;
    padding-block: clamp(56px, 7vw, 96px) 48px;
  }
  .title-block {
    display: grid;
    gap: 22px;
    align-content: start;
  }
  .brand {
    justify-self: start;
    text-decoration: none;
  }
  .mission {
    max-width: 40ch;
    color: var(--paper-soft);
  }
  .col {
    display: grid;
    gap: 14px;
    align-content: start;
  }
  .col .label {
    color: var(--paper-soft);
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0;
  }
  ul a {
    display: inline-block;
    color: var(--paper);
    text-decoration: none;
    background: linear-gradient(var(--signal), var(--signal)) left bottom / 0 1.5px no-repeat;
    /* Área táctil de 44px; el subrayado queda pegado al texto. */
    padding-block: 11px;
    background-position: left calc(100% - 9px);
    transition: background-size 260ms var(--ease-out);
  }
  ul a:hover {
    background-size: 100% 1.5px;
  }
  .bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-block: 24px 32px;
    border-top: 1px solid rgb(241 244 247 / 0.2);
    color: var(--paper-soft);
    font-size: var(--fs-sm);
  }
  .up {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--paper);
    padding-block: 10px;
    text-decoration: none;
    font-weight: 600;
  }
  .up svg {
    width: 14px;
    height: 24px;
    color: var(--signal);
    transition: transform 300ms var(--ease-out);
  }
  .up:hover svg {
    transform: translateY(-4px);
  }
  @media (max-width: 960px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .title-block {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 20px;
    }
    .col:last-child {
      grid-column: 1 / -1;
    }
    .up {
      white-space: nowrap;
    }
  }
</style>
