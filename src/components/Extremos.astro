---
// Los dos extremos del rumbo, dibujados en tinta: la planilla con mensajes de WhatsApp
// de hoy y la pantalla del sistema al que se llega (ejemplo, con datos inventados).
// Coordenadas de la carta del hero; quien lo usa en otro lado lo reubica con transform.
interface Props {
  part: "planilla" | "pantalla";
}
const { part } = Astro.props;
---

{
  part === "planilla" ? (
    <g>
      <rect class="sheet" x="112" y="492" width="132" height="78"></rect>
      <rect class="sheet-head" x="112" y="492" width="132" height="14"></rect>
      <path class="sheet-grid" d="M150 492v78M200 492v78M112 506h132M112 522h132M112 538h132M112 554h132"></path>
      <path class="scrawl" d="M118 514h24M156 514h30M118 530h20M206 530h28M156 546h36M118 562h22M206 562h18"></path>
      <path class="strike" d="M154 526l42 8M204 542l34 10"></path>
      <path class="bubble" d="M214 462h66v24h-48l-8 8v-8h-10z"></path>
      <path class="scrawl" d="M222 471h40M222 478h28"></path>
      <path class="bubble" d="M236 500h56v22h-44l-6 7v-7h-6z"></path>
      <path class="scrawl" d="M244 508h34M244 515h20"></path>
    </g>
  ) : (
    <g>
      <rect class="screen" x="612" y="-58" width="254" height="170"></rect>
      <rect class="screen-bar" x="612" y="-58" width="254" height="20"></rect>
      <path class="screen-mark" d="M626 -52h-8v9h8v-4h-4"></path>
      <rect class="tab" x="806" y="-76" width="60" height="18"></rect>
      <text class="tab-text" x="836" y="-63.5" text-anchor="middle">EJEMPLO</text>
      <rect class="screen-side" x="612" y="-38" width="44" height="150"></rect>
      <rect x="612" y="-28" width="3" height="12" fill="var(--ink)"></rect>
      <path class="screen-nav" d="M622 -22h24M622 -2h18M622 18h22M622 38h16"></path>
      <text class="screen-title" x="668" y="-18">Pedidos de hoy</text>
      {[
        ["1042 · Almacén Sur", "Preparando", false],
        ["1041 · Kiosco Centro", "Entregado", true],
        ["1040 · Dietética Norte", "En camino", false],
      ].map(([who, state, done], r) => (
        <g>
          <line class="screen-rule" x1="668" x2="858" y1={-8 + r * 30} y2={-8 + r * 30}></line>
          <text class="screen-row" x="668" y={11 + r * 30}>{who}</text>
          <rect class={done ? "chip done" : "chip"} x="794" y={-1 + r * 30} width="64" height="16"></rect>
          <text class={done ? "chip-text done" : "chip-text"} x="826" y={10.5 + r * 30} text-anchor="middle">{state}</text>
        </g>
      ))}
      <line class="screen-rule" x1="668" x2="858" y1="82" y2="82"></line>
      <text class="screen-alert" x="668" y="100">Stock bajo: 2 productos</text>
    </g>
  )
}

<style>
  .sheet,
  .screen {
    fill: var(--white);
    stroke: var(--ink);
    stroke-width: 2;
  }
  .sheet-head,
  .screen-side {
    fill: var(--shoal);
  }
  .screen-bar {
    fill: var(--ink);
  }
  .screen-mark {
    fill: none;
    stroke: var(--paper);
    stroke-width: 2;
  }
  .sheet-grid {
    fill: none;
    stroke: var(--rule-strong);
    stroke-width: 1;
  }
  .scrawl,
  .screen-nav,
  .screen-line {
    fill: none;
    stroke: var(--muted);
    stroke-width: 2.5;
    stroke-linecap: round;
  }
  .screen-line {
    stroke: var(--ink-soft);
  }
  .strike {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
  }
  .bubble {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .screen-title {
    font: 700 14px var(--display);
    fill: var(--ink);
  }
  .screen-row {
    font: 500 11px var(--body);
    fill: var(--ink);
  }
  .screen-alert {
    font: 700 11px var(--body);
    fill: var(--ink);
  }
  .screen-rule {
    stroke: var(--rule);
    stroke-width: 1;
  }
  .chip-text {
    font: 600 8.5px var(--body);
    fill: var(--ink);
  }
  .chip-text.done {
    fill: var(--paper);
  }
  .tab {
    fill: var(--ink);
  }
  .tab-text {
    font: 500 8.5px var(--mono);
    letter-spacing: 0.08em;
    fill: var(--paper);
  }
  .chip {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
  }
  .chip.done {
    fill: var(--ink);
  }
</style>
