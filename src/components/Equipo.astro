---
// Quiénes somos: nombre, formación, qué hace cada uno y dónde ver su trabajo. Sin fotos todavía:
// cuando estén, van arriba de cada nombre.
import { TEAM as equipo } from "../config";
---

<section class="section" id="equipo" aria-labelledby="equipo-title">
  <div class="wrap">
    <div class="sec-head">
      <h2 id="equipo-title" data-reveal>Un equipo chico, a propósito.</h2>
      <p data-reveal style="--d:1">
        Elegimos ser pocos para que la persona que te escucha sea la misma que diseña y escribe tu sistema. Cada
        uno conoce tu proyecto de punta a punta, y el que te responde es siempre uno de nosotros.
      </p>
    </div>

    <ul class="crew">
      {
        equipo.map((m, i) => (
          <li data-reveal style={`--d:${i}`}>
            <div class="who">
              <h3>{m.nombre}</h3>
              <p class="label">{m.formacion}</p>
            </div>
            <p class="linea">{m.linea}</p>
            {m.links.length > 0 && (
              <p class="links">
                {m.links.map((l) => (
                  <a href={l.href} target="_blank" rel="noopener">
                    {l.label}
                    <span class="sr-only"> de {m.nombre} (se abre en otra pestaña)</span>
                  </a>
                ))}
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .crew {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px clamp(24px, 4vw, 64px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 12px;
    padding-top: 20px;
    border-top: 2px solid var(--ink);
  }
  .who {
    display: grid;
    gap: 2px;
  }
  h3 {
    font-size: var(--fs-xl);
  }
  .linea {
    color: var(--ink-soft);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
    font-weight: 600;
    font-size: var(--fs-sm);
  }
  .links a {
    display: inline-block;
    padding-block: 11px;
    text-decoration-color: var(--line-strong);
  }
  .links a:hover {
    text-decoration-color: var(--signal);
  }
  @media (max-width: 860px) {
    .crew {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
