---
// Quiénes somos: nombre, formación, qué hace cada uno y dónde ver su trabajo.
// Las iniciales ocupan el lugar de la foto hasta que tengamos fotos del equipo: se cambia
// sumando `foto` a cada integrante en config.ts.
import { TEAM as equipo } from "../config";
const iniciales = (n: string) =>
  n
    .split(" ")
    .map((p) => p[0])
    .slice(0, 2)
    .join("");
---

<section class="section tint" id="equipo" aria-labelledby="equipo-title">
  <div class="wrap">
    <div class="sec-head">
      <h2 id="equipo-title">Un equipo chico, a propósito.</h2>
      <p>
        Elegimos ser pocos para que la persona que te escucha sea la misma que diseña y escribe tu sistema. Cada
        uno conoce tu proyecto de punta a punta, y el que te responde es siempre uno de nosotros.
      </p>
    </div>

    <ul class="crew">
      {
        equipo.map((m) => (
          <li>
            <span class="avatar" aria-hidden="true">{iniciales(m.nombre)}</span>
            <div class="who">
              <h3>{m.nombre}</h3>
              <p class="label">{m.formacion}</p>
            </div>
            <p class="linea">{m.linea}</p>
            {m.links.length > 0 && (
              <p class="links">
                {m.links.map((l) => (
                  <a href={l.href} target="_blank" rel="noopener">
                    {l.label}
                    <span class="sr-only"> de {m.nombre} (se abre en otra pestaña)</span>
                  </a>
                ))}
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .crew {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 14px;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    transition: border-color 220ms var(--ease-out), box-shadow 220ms var(--ease-out), transform 220ms var(--ease-out);
  }
  @media (hover: hover) {
    li:hover {
      border-color: var(--line-strong);
      box-shadow: var(--shadow);
      transform: translateY(-2px);
    }
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--white);
    font-weight: 700;
    font-size: var(--fs-lg);
    letter-spacing: 0.02em;
  }
  .who {
    display: grid;
    gap: 2px;
  }
  h3 {
    font-size: var(--fs-lg);
  }
  .linea {
    color: var(--ink-soft);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
    padding-top: 6px;
    border-top: 1px solid var(--line);
    font-weight: 600;
    font-size: var(--fs-sm);
  }
  .links a {
    display: inline-block;
    padding-block: 11px;
    text-decoration-color: var(--line-strong);
  }
  .links a:hover {
    text-decoration-color: var(--signal);
  }
  @media (max-width: 960px) {
    .crew {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
    li {
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-rows: none;
      column-gap: 18px;
      padding: 22px;
    }
    .avatar {
      grid-row: span 3;
      width: 52px;
      height: 52px;
      font-size: 1.05rem;
    }
    .who,
    .linea,
    .links {
      grid-column: 2;
    }
  }
</style>
