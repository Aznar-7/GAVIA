---
// Quiénes somos: nombre, formación, qué hace cada uno y dónde ver su trabajo.
// Las iniciales ocupan el lugar de la foto hasta que tengamos fotos del equipo: se cambia
// sumando `foto` a cada integrante en config.ts.
import { TEAM as equipo } from "../config";
const iniciales = (n: string) =>
  n
    .split(" ")
    .map((p) => p[0])
    .slice(0, 2)
    .join("");
---

<section class="section tint" id="equipo" aria-labelledby="equipo-title">
  <div class="wrap">
    <div class="sec-head split">
      <p class="kicker" data-reveal>Equipo</p>
      <h2 id="equipo-title" data-reveal>Un equipo chico, <span class="em">a propósito</span>.</h2>
      <p data-reveal style="--d:1">
        Elegimos ser pocos para que la persona que te escucha sea la misma que diseña y escribe tu sistema. Cada
        uno conoce tu proyecto de punta a punta, y el que te responde es siempre uno de nosotros.
      </p>
    </div>

    <ul class="crew">
      {
        equipo.map((m, i) => (
          <li class="spot" data-reveal style={`--d:${i}`}>
            <span class="avatar" aria-hidden="true">{iniciales(m.nombre)}</span>
            <div class="who">
              <h3>{m.nombre}</h3>
              <p class="label">{m.formacion}</p>
            </div>
            <p class="linea">{m.linea}</p>
            {m.links.length > 0 && (
              <p class="links">
                {m.links.map((l) => (
                  <a href={l.href} target="_blank" rel="noopener">
                    {l.label}
                    <span class="sr-only"> de {m.nombre} (se abre en otra pestaña)</span>
                  </a>
                ))}
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .crew {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 16px;
    padding: clamp(24px, 2.6vw, 36px);
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: inset 0 0 0 1px rgb(12 26 43 / 0.06), var(--shadow-sm);
    transition: border-color 220ms var(--ease-out), box-shadow 220ms var(--ease-out), translate 220ms var(--ease-out), opacity 700ms var(--ease-out), transform 900ms var(--ease-out);
  }
  @media (hover: hover) {
    li:hover {
      box-shadow: inset 0 0 0 1px rgb(12 26 43 / 0.08), var(--shadow);
      translate: 0 -4px;
    }
  }
  .avatar {
    position: relative;
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    margin-bottom: 8px;
    border-radius: 20px;
    background: radial-gradient(120% 120% at 20% 0%, #2a4468, var(--night));
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.12), 0 12px 24px -12px rgb(7 17 29 / 0.6);
    color: var(--white);
    font: italic 400 1.9rem / 1 var(--serif);
    letter-spacing: 0;
  }
  .avatar::after {
    content: "";
    position: absolute;
    right: -3px;
    bottom: -3px;
    width: 18px;
    height: 18px;
    border: 3px solid var(--white);
    background: var(--signal);
  }
  .who {
    display: grid;
    gap: 2px;
  }
  h3 {
    font-size: var(--fs-xl);
    font-weight: 500;
  }
  .linea {
    color: var(--ink-soft);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
    padding-top: 6px;
    border-top: 1px solid var(--line);
    font-weight: 500;
    font-size: var(--fs-sm);
  }
  .links a {
    display: inline-block;
    padding-block: 11px;
    text-decoration-color: var(--line-strong);
  }
  .links a:hover {
    text-decoration-color: var(--signal);
  }
  @media (max-width: 960px) {
    .crew {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
    li {
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-rows: none;
      column-gap: 18px;
      padding: 22px;
    }
    .avatar {
      grid-row: span 3;
      width: 56px;
      height: 56px;
      margin-bottom: 0;
      border-radius: 16px;
      font-size: 1.5rem;
    }
    .who,
    .linea,
    .links {
      grid-column: 2;
    }
  }
</style>
