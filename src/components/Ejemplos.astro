---
// Antes y después: problemas típicos de una pyme y el sistema que los resuelve.
// Son ejemplos de lo que se puede construir, no clientes.
const casos = [
  { hoy: "El stock vive en una planilla que nadie actualiza a tiempo.", con: "Un sistema de stock que avisa cuándo reponer." },
  { hoy: "Los turnos se dan por WhatsApp y se pisan entre sí.", con: "Una agenda online con recordatorios automáticos." },
  { hoy: "Los pedidos llegan por mensaje y alguien los pasa a mano.", con: "Un portal donde el cliente pide y sigue el estado." },
  { hoy: "Cada mes alguien arma los reportes copiando y pegando.", con: "Un reporte con los números del negocio, siempre al día." },
  { hoy: "Los repartos se coordinan con papelitos y llamadas.", con: "Una app para el chofer con la hoja de ruta del día." },
];
---

<section class="section tint" id="ejemplos" aria-labelledby="ejemplos-title">
  <div class="wrap">
    <div class="sec-head">
      <h2 id="ejemplos-title">¿Te suena alguna?</h2>
      <p>Problemas que vemos todo el tiempo en empresas chicas y medianas, y lo que se puede construir para resolverlos.</p>
    </div>

    <div class="table" role="table" aria-label="Problemas frecuentes y cómo se resuelven">
      <div class="row head" role="row">
        <span role="columnheader">Hoy</span>
        <span role="columnheader">Con un sistema a medida</span>
      </div>
      {
        casos.map((c) => (
          <div class="row" role="row">
            <p role="cell" class="hoy">{c.hoy}</p>
            <p role="cell" class="con">{c.con}</p>
          </div>
        ))
      }
    </div>

    <p class="cta-line">
      ¿Tenés otro problema? <a href="#contacto">Contanoslo</a> y te decimos si se puede resolver con software, aunque
      la respuesta sea que no.
    </p>
  </div>
</section>

<style>
  .table {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 32px;
    padding: 20px 28px;
    border-top: 1px solid var(--line);
    transition: background-color 200ms var(--ease-out);
  }
  .head {
    border-top: 0;
    padding-block: 14px;
    background: var(--paper);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--muted);
  }
  /* Al pasar el cursor, el problema de hoy se tacha en naranja y la solución se adelanta. */
  .hoy {
    color: var(--ink-soft);
    text-decoration: line-through;
    text-decoration-thickness: 2px;
    text-decoration-color: transparent;
    transition: text-decoration-color 260ms var(--ease-out), color 260ms var(--ease-out);
  }
  .con {
    font-weight: 600;
    transition: transform 260ms var(--ease-out);
  }
  @media (hover: hover) {
    .row:not(.head):hover {
      background: #f8fafc;
    }
    .row:hover .hoy {
      color: var(--muted);
      text-decoration-color: var(--signal);
    }
    .row:hover .con {
      transform: translateX(4px);
    }
  }
  /* En pantallas táctiles no hay cursor: el tachado se ve siempre, suave. */
  @media (hover: none) {
    .hoy {
      color: var(--muted);
      text-decoration-color: var(--line-strong);
    }
  }
  .cta-line {
    margin-top: 28px;
    color: var(--ink-soft);
  }
  .cta-line a {
    font-weight: 700;
    color: var(--ink);
  }
  /* Celular: cada caso es un bloque con su "hoy" arriba y la solución abajo. */
  @media (max-width: 680px) {
    .head {
      display: none;
    }
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 6px;
      padding: 18px 20px;
    }
    .row:nth-child(2) {
      border-top: 0;
    }
    .hoy::before {
      content: "Hoy: ";
      font-weight: 600;
      color: var(--muted);
    }
    .con::before {
      content: "Con un sistema: ";
      font-weight: 400;
      color: var(--muted);
    }
  }
</style>
