---
import "@fontsource-variable/figtree/wght.css";
import "../styles/global.css";
import { ANALYTICS, CONTACT_EMAIL, SOCIAL, TEAM } from "../config";
import Analytics from "@vercel/analytics/astro";
import bodyFont from "@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const site = Astro.site ?? new URL("https://www.gaviasoftware.com");
const ogImage = new URL("/og.png", site);
const canonical = new URL(Astro.url.pathname, site);
// Datos para buscadores y asistentes de IA: quién es Gavia, quiénes la hacen y qué ofrece.
const orgId = new URL("/#gavia", site).toString();
const org = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "ProfessionalService"],
      "@id": orgId,
      name: "Gavia",
      alternateName: "Gavia Software",
      url: site.toString(),
      description,
      email: CONTACT_EMAIL,
      foundingDate: "2026-10",
      foundingLocation: { "@type": "Place", name: "Córdoba, Argentina" },
      address: { "@type": "PostalAddress", addressLocality: "Córdoba", addressRegion: "Córdoba", addressCountry: "AR" },
      areaServed: [
        { "@type": "City", name: "Córdoba" },
        { "@type": "Country", name: "Argentina" },
      ],
      founder: TEAM.map((m) => ({
        "@type": "Person",
        name: m.nombre,
        jobTitle: "Cofundador",
        ...(m.links.length > 0 && { sameAs: m.links.map((l) => l.href) }),
      })),
      knowsAbout: ["Desarrollo de software a medida", "Sistemas de gestión", "Aplicaciones web", "Aplicaciones móviles", "Integraciones", "Automatización", "IoT"],
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Servicios",
        itemListElement: ["Sistemas de gestión a medida", "Aplicaciones web y móviles", "Integraciones entre sistemas", "Automatización de procesos", "Dispositivos conectados e IoT", "Mantenimiento de software"].map((name) => ({
          "@type": "Offer",
          itemOffered: { "@type": "Service", name, areaServed: "AR" },
        })),
      },
      logo: new URL("/favicon.svg", site).toString(),
      image: ogImage.toString(),
      ...(SOCIAL.length > 0 && { sameAs: SOCIAL.map((s) => s.href) }),
    },
    {
      "@type": "WebSite",
      url: site.toString(),
      name: "Gavia",
      inLanguage: "es-AR",
      publisher: { "@id": orgId },
    },
  ],
};
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Antes de pintar: marca que hay JS y si la persona pidió reducir movimiento.
      document.documentElement.classList.add("js");
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("reduce");
    </script>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#12243A" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Gavia" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Gavia: software con rumbo. Diseñamos, construimos y mantenemos el software de tu empresa." />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <slot />
    {ANALYTICS && !noindex && <Analytics />}
    <script>
      // Movimiento compartido por toda la página. Sin JS o con "reducir movimiento", todo
      // queda quieto y visible.
      const reduce = document.documentElement.classList.contains("reduce");

      // Apariciones al entrar en pantalla.
      const items = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if (reduce || !("IntersectionObserver" in window)) {
        items.forEach((el) => el.classList.add("in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          },
          { rootMargin: "0px 0px -12% 0px" },
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 16px;
    top: -60px;
    z-index: 100;
    padding: 10px 16px;
    background: var(--ink);
    color: var(--white);
    border-radius: var(--radius-sm);
    font-weight: 600;
  }
  .skip:focus {
    top: 12px;
  }
</style>
