---
// Página no encontrada: una salida clara, con el mismo sistema que el resto del sitio.
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
---

<Base title="Página no encontrada | Gavia" description="Esta página no existe. Volvé al inicio de Gavia." noindex>
  <main id="contenido" class="lost">
    <div class="wrap inner">
      <a href="/" class="home" aria-label="Gavia, ir al inicio"><Logo size={26} /></a>
      <div class="copy">
        <h1>No encontramos esta página.</h1>
        <p class="lead">Puede que el link esté mal o que la hayamos movido.</p>
        <div class="actions">
          <a class="btn" href="/">Volver al inicio</a>
          <a class="btn secondary" href="/#contacto">Contanos qué buscabas</a>
        </div>
      </div>
    </div>
  </main>
</Base>

<style>
  .lost {
    display: flex;
    min-height: 100svh;
    background: var(--paper);
  }
  .inner {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 40px;
    padding-block: 24px clamp(48px, 8vw, 96px);
  }
  .home {
    justify-self: start;
    padding-block: 6px;
    text-decoration: none;
  }
  .copy {
    display: grid;
    gap: 20px;
    align-content: center;
    justify-items: start;
  }
  h1 {
    font-size: var(--fs-hero);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .lead {
    font-size: var(--fs-lead);
    color: var(--ink-soft);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
</style>
